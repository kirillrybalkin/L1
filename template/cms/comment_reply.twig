<style>
    /* 1. КОНТЕЙНЕР ВІДПОВІДЕЙ (SUB_LOG) */
    .reply-item {
        background: rgba(255, 255, 255, 0.02);
        border-top: 1px solid #111;
        border-left: 2px solid #333;
        margin-left: 20px;
        padding: 12px 15px 12px 25px !important;
        position: relative;
    }
    .reply-item::before {
        content: "";
        position: absolute;
        top: 20px;
        left: 0;
        width: 15px;
        height: 1px;
        background: #333;
    }

    .reply-meta {
        font-family: 'Consolas', monospace;
        font-size: 10px;
        color: #555;
        text-transform: uppercase;
        margin-bottom: 5px;
    }
    .reply-author { color: #ff0000; font-weight: 700; }

    .reply-text {
        font-family: 'Consolas', monospace;
        font-size: 13px;
        color: #aaa;
        line-height: 1.4;
    }

    /* 2. ПАНЕЛЬ КЕРУВАННЯ БУФЕРОМ */
    .reply-control-panel {
        background: #000;
        border-top: 1px solid #1a1a1a;
        padding: 10px !important;
    }
    .btn-buffer {
        background: transparent !important;
        border: 1px solid #222 !important;
        color: #444 !important;
        font-family: 'Orbitron', sans-serif;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 0 !important;
        padding: 6px 15px !important;
        transition: 0.3s;
    }
    .btn-buffer:hover:not(:disabled) {
        border-color: #ff0000 !important;
        color: #ff0000 !important;
    }
    .btn-buffer:disabled { opacity: 0.2; cursor: not-allowed; }
</style>

{% if replies %}
  <div id="reply-{{ parent_id }}-{{ page }}">
    {% for reply in replies %}
      <div class="reply-item">
        <div class="reply-meta">
          <i class="fa-solid fa-caret-right me-1"></i>
          {{ text_by }} <span class="reply-author">{{ reply.author }}</span>
          <span class="ms-2" style="color:#222">//</span> {{ reply.date_added }}
        </div>
        <div class="reply-text">
          {{ reply.comment }}
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}

<div class="reply-control-panel text-center">
  <button type="button" value="{{ refresh }}" id="button-refresh-{{ parent_id }}" data-oc-toggle="refresh" data-oc-target="#reply-{{ parent_id }}-{{ page }}" class="btn btn-buffer d-none">
    <i class="fa-solid fa-sync fa-spin"></i>
  </button>

  {% if not replies %}
    <button type="button" class="btn btn-buffer" disabled>
        <i class="fa-solid fa-ban me-1"></i> {{ button_replies }}
    </button>
  {% elseif next %}
    <button type="button" value="{{ next }}" data-oc-toggle="next" class="btn btn-buffer">
        <i class="fa-solid fa-angles-down me-1"></i> EXPAND_DATA_BUFFER
    </button>
  {% else %}
    <button type="button" class="btn btn-buffer" disabled>
        <i class="fa-solid fa-check-double me-1"></i> END_OF_THREAD
    </button>
  {% endif %}
</div>