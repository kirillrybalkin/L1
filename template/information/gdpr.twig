{{ header }}
<style>
    /* 1. ЗАГОЛОВОК ТА ШЛЯХ */
    #account-gdpr h1 {
        font-family: 'Orbitron', sans-serif;
        color: #ff0000;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 25px;
        border-left: 5px solid #ff0000;
        padding-left: 20px;
    }
    #account-gdpr p {
        font-family: 'Consolas', monospace;
        font-size: 13px;
        color: #888;
    }

    /* 2. ПОЛЯ ТА ЛЕГЕНДИ (SECURITY_BLOCKS) */
    fieldset {
        background: rgba(5, 5, 5, 0.5);
        border: 1px solid #1a1a1a;
        padding: 25px;
        margin-bottom: 30px;
        position: relative;
    }
    legend {
        font-family: 'Orbitron';
        color: #fff;
        font-size: 14px;
        text-transform: uppercase;
        width: auto;
        padding: 0 15px;
        float: none;
        margin-bottom: 20px;
    }

    /* 3. ВВІД ДАНИХ (INPUT_PORTS) */
    .form-control {
        background: #000 !important;
        border: 1px solid #333 !important;
        color: #00ff00 !important;
        font-family: 'Consolas', monospace;
        border-radius: 0 !important;
    }
    .input-group-text {
        background: #111 !important;
        border: 1px solid #333 !important;
        color: #ff0000 !important;
        border-radius: 0 !important;
    }
    .form-check-label strong {
        font-family: 'Orbitron';
        font-size: 12px;
        color: #eee;
        text-transform: uppercase;
    }

    /* 4. КРИТИЧНЕ ПОПЕРЕДЖЕННЯ (HAZARD_BLOCK) */
    #collapse-remove {
        background: #1a0f00 !important;
        border: 1px solid #ff8800 !important;
        border-left: 5px solid #ff8800 !important;
        color: #ff8800 !important;
        border-radius: 0 !important;
        font-family: 'Consolas', monospace;
        padding: 20px;
    }
    #collapse-remove i { font-size: 24px; margin-bottom: 10px; display: block; }
    #collapse-remove ul li { margin-bottom: 5px; font-size: 12px; }

    /* 5. КНОПКИ (CMD_SWITCH) */
    .btn-abort {
        background: transparent !important;
        border: 1px solid #333 !important;
        color: #555 !important;
        font-family: 'Orbitron';
        font-size: 10px;
        border-radius: 0;
        text-transform: uppercase;
    }
    .btn-abort:hover { border-color: #ff0000; color: #ff0000 !important; }

    .btn-execute {
        background: #ff0000 !important;
        color: #000 !important;
        font-family: 'Orbitron';
        font-weight: 900;
        border-radius: 0;
        border: none;
        padding: 12px 30px !important;
        text-transform: uppercase;
    }
    .btn-execute:hover { background: #fff !important; box-shadow: 0 0 20px rgba(255,0,0,0.4); }
</style>

<div id="account-gdpr" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  {% if success %}
    <div class="alert alert-success alert-dismissible" style="background:#000; border:1px solid #00ff00; color:#00ff00; border-radius:0;">
        <i class="fa-solid fa-circle-check"></i> {{ success }}
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
  {% endif %}

  <div class="row">
    {{ column_left }}

    <div id="content" class="col">
      {{ content_top }}

      <h1><i class="fa-solid fa-shield-halved me-3"></i>{{ heading_title }}</h1>

      <div class="mb-4">
        <p><i class="fa-solid fa-terminal me-2"></i> {{ text_gdpr|format(store, gdpr, title) }}</p>
      </div>

      <form action="{{ action }}" method="post" data-oc-toggle="ajax">
        <fieldset>
          <legend id="account"><i class="fa-solid fa-fingerprint me-2"></i> {{ text_verification }}</legend>
          <div class="mb-3">
            <label for="input-email" class="form-label" style="font-family:'Orbitron'; font-size:10px; color:#444;">{{ text_email }}</label>
            <div class="input-group">
              <input type="text" name="email" value="{{ email }}" placeholder="USER_IDENT_MAIL" id="input-email" class="form-control"/>
              <div class="input-group-text"><i class="fa-solid fa-key"></i></div>
            </div>
            <div id="error-email" class="invalid-feedback"></div>
          </div>
        </fieldset>

        <fieldset>
          <legend id="action"><i class="fa-solid fa-sliders me-2"></i> {{ text_action }}</legend>

          <div class="mb-4">
            <div class="form-check mb-3">
              <input type="radio" name="action" value="export" id="input-export" checked class="form-check-input" style="border-color:#ff0000;"/>
              <label for="input-export" class="form-check-label"><strong>{{ text_export }}</strong></label>
            </div>
            <div class="form-check">
              <input type="radio" name="action" value="remove" id="input-remove" class="form-check-input" style="border-color:#ff0000;"/>
              <label for="input-remove" class="form-check-label"><strong>{{ text_remove }}</strong></label>
            </div>
          </div>

          <div id="collapse-remove" class="alert collapse">
            <p><i class="fa-solid fa-radiation"></i> {{ text_warning }}</p>
            <ul class="list-unstyled">
              <li><i class="fa-solid fa-caret-right me-2"></i> {{ text_access|format(store) }}</li>
              <li><i class="fa-solid fa-caret-right me-2"></i> {{ text_history }}</li>
              <li><i class="fa-solid fa-caret-right me-2"></i> {{ text_limit|format(limit) }}</li>
            </ul>
          </div>
        </fieldset>

        <div class="row align-items-center mt-4">
          <div class="col">
            <a href="{{ cancel }}" class="btn btn-abort"><i class="fa-solid fa-xmark me-2"></i> ABORT_COMMAND</a>
          </div>
          <div class="col text-end">
            <button type="submit" class="btn btn-execute">
                <i class="fa-solid fa-check-double me-2"></i> {{ button_continue }}
            </button>
          </div>
        </div>
      </form>

      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>



<script type="text/javascript"></script>
{{ footer }}