{{ header }}

&lt;style&gt;
    /* 1. ГЛОБАЛЬНЫЙ ФОН И СТРУКТУРА */
    main {
        display: block;
        position: relative;
        z-index: 1;
        background-color: #0d0d0d;
    }

    #account-payment-method {
        background-color: #0d0d0d !important;
        color: #eee !important;
        padding-top: 40px;
        padding-bottom: 80px;
        min-height: 75vh;
    }

    .breadcrumb { display: none !important; }

    /* 2. ЗАГОЛОВОК */
    h1 {
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        border-left: 5px solid #ff0000;
        padding-left: 20px;
        color: #fff;
        margin-bottom: 35px;
        font-size: 1.6rem;
    }

    /* 3. КОНТЕНТНАЯ КАРТОЧКА */
    .payment-card {
        background: #111;
        border: 1px solid #222;
        padding: 40px;
        border-top: 3px solid #ff0000;
    }

    /* Таблица методов (если они есть) */
    .table-garage {
        width: 100%;
        color: #ccc;
        border-collapse: collapse;
    }

    .table-garage td {
        padding: 15px;
        border-bottom: 1px solid #222;
    }

    /* 4. КНОПКИ */
    .buttons {
        margin-top: 30px;
    }

    .btn-back-custom {
        background: transparent !important;
        border: 2px solid #333 !important;
        color: #666 !important;
        border-radius: 0 !important;
        padding: 14px 35px !important;
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        font-weight: 700;
        font-size: 13px;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        transition: 0.3s all ease;
    }

    .btn-back-custom i { margin-right: 10px; }

    .btn-back-custom:hover {
        border-color: #fff !important;
        background-color: #fff !important;
        color: #000 !important;
        transform: translateY(-2px);
    }

    /* 5. ЛОГОТИП СПРАВА */
    .payment-sidebar-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        padding-left: 40px;
    }

    .payment-sidebar-logo img {
        max-width: 100%;
        filter: drop-shadow(0 0 15px rgba(255, 0, 0, 0.2));
        transition: 0.5s ease;
    }

    .payment-sidebar-logo img:hover {
        filter: drop-shadow(0 0 25px rgba(255, 0, 0, 0.5));
        transform: scale(1.03);
    }

    .lang-block { display: none !important; }
&lt;/style&gt;

&lt;main&gt;
    &lt;div id=&quot;account-payment-method&quot; class=&quot;container&quot;&gt;
        &lt;div class=&quot;row&quot;&gt;
            &lt;div id=&quot;content&quot; class=&quot;col-lg-7 col-md-12&quot;&gt;
                {{ content_top }}
                
                &lt;h1&gt;
                    &lt;span class=&quot;lang-block lang-en&quot;&gt;Payment Methods&lt;/span&gt;
                    &lt;span class=&quot;lang-block lang-ua&quot;&gt;Способи оплати&lt;/span&gt;
                    &lt;span class=&quot;lang-block lang-pl&quot;&gt;Metody płatności&lt;/span&gt;
                &lt;/h1&gt;

                &lt;div class=&quot;payment-card&quot;&gt;
                    {% if payment_methods %}
                        &lt;div class=&quot;table-responsive&quot;&gt;
                            &lt;table class=&quot;table-garage&quot;&gt;
                                &lt;tbody&gt;
                                {% for payment_method in payment_methods %}
                                    &lt;tr&gt;
                                        &lt;td&gt;&lt;b&gt;{{ payment_method.name }}&lt;/b&gt;&lt;/td&gt;
                                        &lt;td class=&quot;text-end&quot;&gt;&lt;a href=&quot;{{ payment_method.delete }}&quot; class=&quot;btn btn-danger&quot; style=&quot;border-radius:0;&quot;&gt;&lt;i class=&quot;fa-solid fa-trash-can&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;
                                    &lt;/tr&gt;
                                {% endfor %}
                                &lt;/tbody&gt;
                            &lt;/table&gt;
                        &lt;/div&gt;
                    {% else %}
                        &lt;p style=&quot;color:#666; font-style: italic; margin-bottom: 0;&quot;&gt;
                            &lt;span class=&quot;lang-block lang-en&quot;&gt;You have no saved payment methods.&lt;/span&gt;
                            &lt;span class=&quot;lang-block lang-ua&quot;&gt;У вас немає збережених способів оплати.&lt;/span&gt;
                            &lt;span class=&quot;lang-block lang-pl&quot;&gt;Nie masz zapisanych metod płatności.&lt;/span&gt;
                        &lt;/p&gt;
                    {% endif %}
                &lt;/div&gt;

                &lt;div class=&quot;buttons&quot;&gt;
                    &lt;a href=&quot;{{ back }}&quot; class=&quot;btn-back-custom&quot;&gt;
                        &lt;i class=&quot;fa-solid fa-arrow-left&quot;&gt;&lt;/i&gt;
                        &lt;span class=&quot;lang-block lang-en&quot;&gt;Back&lt;/span&gt;
                        &lt;span class=&quot;lang-block lang-ua&quot;&gt;Назад&lt;/span&gt;
                        &lt;span class=&quot;lang-block lang-pl&quot;&gt;Powrót&lt;/span&gt;
                    &lt;/a&gt;
                &lt;/div&gt;

                {{ content_bottom }}
            &lt;/div&gt;

            &lt;div class=&quot;col-lg-5 d-none d-lg-flex align-items-center&quot;&gt;
                &lt;div class=&quot;payment-sidebar-logo&quot;&gt;
                    &lt;img src=&quot;http://localhost/myshop/image/catalog/лого кар2.png&quot; alt=&quot;Logo&quot;&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/main&gt;

