<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<base href="{{ base }}" />
{% if description %}<meta name="description" content="{{ description }}" />{% endif %}
{% if keywords %}<meta name="keywords" content="{{ keywords }}" />{% endif %}
<script src="{{ jquery }}" type="text/javascript"></script>
<link href="{{ bootstrap }}" rel="stylesheet" media="screen" />
<link href="catalog/view/fontawesome/css/all.min.css" rel="stylesheet" type="text/css" />
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
<link href="catalog/view/theme/default/stylesheet/stylesheet.css" rel="stylesheet">

<style>
    :root {
        --main-red: #FF0000;
        --dark-bg: #050505;
        --border-color: #333333;
        --text-gray: #aaaaaa;
    }

    body {
        background-color: var(--dark-bg);
        color: #ffffff;
        font-family: 'Roboto', sans-serif;
    }

    /* ВЕРХНЯ ПАНЕЛЬ */
    nav#top {
        background: #000;
        border-bottom: 1px solid var(--border-color);
        padding: 8px 0;
    }
    nav#top .nav-link {
        color: var(--text-gray) !important;
        font-size: 11px;
        text-transform: uppercase;
    }
    nav#top .nav-link:hover {
        color: #fff !important;
    }

    /* ГОЛОВНИЙ HEADER */
    header {
        background: var(--dark-bg);
        padding: 30px 0;
    }

    /* ПОШУК (Прибираємо зелений, робимо строгий сірий) */
    #search .form-control {
        background: #111 !important;
        border: 1px solid var(--border-color) !important;
        color: #fff !important;
        border-radius: 0;
        font-family: 'Courier New', monospace;
    }
    #search .form-control::placeholder {
        color: #444;
        text-transform: uppercase;
        font-size: 12px;
    }
    #search .btn-light {
        background: #222 !important;
        border: 1px solid var(--border-color) !important;
        color: #fff !important;
        border-radius: 0;
    }

    /* КОШИК (Як на скріні: Червона іконка, білий текст) */
    #cart .btn-inverse {
        background: #000 !important;
        border: 1px solid var(--main-red) !important;
        border-radius: 0;
        color: #fff;
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        font-size: 13px;
        padding: 10px 20px;
    }
    #cart i.fa-chip { /* Або твоя іконка */
        color: var(--main-red);
        margin-right: 10px;
    }

    /* ЛОГОТИП */
    #logo img {
        max-width: 250px;
        filter: drop-shadow(0 0 5px rgba(255,0,0,0.2));
    }

    /* МЕНЮ */
    #menu {
        background: #000;
        border-top: 1px solid var(--border-color);
        border-bottom: 2px solid var(--main-red);
    }
    #menu .nav-link {
        color: #fff !important;
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: 1px;
        padding: 15px 25px !important;
    }
    #menu .nav-link:hover {
        background: var(--main-red);
        color: #000 !important;
    }
</style>
</head>
<body>

<nav id="top">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        {{ currency }}
        {{ language }}
      </div>
      <div id="top-links" class="nav">
        <ul class="list-inline m-0">
          <li class="list-inline-item"><a href="tel:{{ telephone }}" class="nav-link"><i class="fa-solid fa-phone"></i> <span class="d-none d-md-inline">{{ telephone }}</span></a></li>
          <li class="list-inline-item">
            <div class="dropdown">
              <a href="{{ account }}" title="{{ text_account }}" class="nav-link dropdown-toggle" data-bs-toggle="dropdown"><i class="fa-solid fa-user"></i> <span class="d-none d-md-inline">{{ text_account }}</span></a>
              <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                {% if not logged %}
                  <li><a href="{{ register }}" class="dropdown-item">{{ text_register }}</a></li>
                  <li><a href="{{ login }}" class="dropdown-item">{{ text_login }}</a></li>
                {% else %}
                  <li><a href="{{ account }}" class="dropdown-item">{{ text_account }}</a></li>
                  <li><a href="{{ order }}" class="dropdown-item">{{ text_order }}</a></li>
                  <li><a href="{{ logout }}" class="dropdown-item">{{ text_logout }}</a></li>
                {% endif %}
              </ul>
            </div>
          </li>
          <li class="list-inline-item"><a href="{{ wishlist }}" id="wishlist-total" title="{{ text_wishlist }}" class="nav-link"><i class="fa-solid fa-heart"></i> <span class="d-none d-md-inline">{{ text_wishlist }}</span></a></li>
          <li class="list-inline-item"><a href="{{ shopping_cart }}" title="{{ text_shopping_cart }}" class="nav-link"><i class="fa-solid fa-cart-shopping"></i> <span class="d-none d-md-inline">{{ text_shopping_cart }}</span></a></li>
          <li class="list-inline-item"><a href="{{ checkout }}" title="{{ text_checkout }}" class="nav-link"><i class="fa-solid fa-share"></i> <span class="d-none d-md-inline">{{ text_checkout }}</span></a></li>
        </ul>
      </div>
    </div>
  </div>
</nav>

<header>
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-4 text-center text-md-start">
        <div id="logo">
          {% if logo %}
            <a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-fluid" /></a>
          {% else %}
            <h1><a href="{{ home }}">{{ name }}</a></h1>
          {% endif %}
        </div>
      </div>
      <div class="col-md-5">
        {{ search }}
      </div>
      <div class="col-md-3 text-end">
        {{ cart }}
      </div>
    </div>
  </div>
</header>

{{ menu }}