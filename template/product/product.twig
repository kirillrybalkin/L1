{{ header }}
<style>
    /* 1. ЗАГАЛЬНА СТИЛІЗАЦІЯ КАРТКИ (STATION_LAYOUT) */
    #product-info h1 {
        font-family: 'Orbitron', sans-serif;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 28px;
        margin-bottom: 20px;
        border-bottom: 2px solid #ff0000;
        padding-bottom: 10px;
    }

    /* 2. ГАЛЕРЕЯ (VISUAL_SENSOR) */
    .product-image-main {
        background: #000;
        border: 1px solid #1a1a1a;
        padding: 10px;
        position: relative;
    }
    .product-image-main img {
        border: 1px solid #333;
        transition: 0.3s;
    }
    .product-image-main:hover img {
        border-color: #ff0000;
    }
    .additional-images img {
        background: #000;
        border: 1px solid #1a1a1a;
        margin-top: 10px;
        padding: 5px;
        width: 80px;
        transition: 0.2s;
    }
    .additional-images img:hover {
        border-color: #ff0000;
    }

    /* 3. БЛОК ДАНИХ (SPEC_SHEET) */
    .stats-list {
        background: #0a0a0a;
        border-left: 3px solid #ff0000;
        padding: 15px 20px;
        font-family: 'Consolas', monospace;
        font-size: 13px;
        color: #888;
        margin-bottom: 25px;
    }
    .stats-list li { margin-bottom: 5px; }
    .stats-list b { color: #444; text-transform: uppercase; margin-right: 5px; }
    .stats-list a { color: #ff0000; text-decoration: none; }

    /* 4. ЦІНА ТА КНОПКИ (CMD_INTERFACE) */
    .price-block {
        background: #111;
        padding: 20px;
        border: 1px solid #1a1a1a;
        margin-bottom: 25px;
    }
    .price-new {
        font-family: 'Orbitron', sans-serif;
        color: #00ff00;
        font-size: 36px;
        text-shadow: 0 0 15px rgba(0, 255, 0, 0.3);
    }
    .price-old {
        color: #444;
        text-decoration: line-through;
        font-size: 16px;
    }

    #button-cart {
        background: #ff0000 !important;
        border: none !important;
        color: #000 !important;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 2px;
        border-radius: 0;
        padding: 15px 30px;
        transition: 0.3s;
    }
    #button-cart:hover {
        background: #fff !important;
        box-shadow: 0 0 20px rgba(255, 0, 0, 0.5);
    }

    /* 5. ВКЛАДКИ (DATA_TABS) */
    .nav-tabs { border-bottom: 2px solid #1a1a1a; }
    .nav-tabs .nav-link {
        background: transparent !important;
        border: none !important;
        color: #444 !important;
        font-family: 'Orbitron';
        font-size: 11px;
        text-transform: uppercase;
        padding: 15px 25px;
        border-radius: 0;
    }
    .nav-tabs .nav-link.active {
        color: #ff0000 !important;
        border-bottom: 2px solid #ff0000 !important;
    }
    .tab-content {
        background: #050505;
        border: 1px solid #1a1a1a;
        border-top: none;
        padding: 30px;
        color: #888;
        line-height: 1.8;
        font-family: 'Consolas', monospace;
    }
    .table-bordered { border: 1px solid #1a1a1a !important; color: #888 !important; }
    .table-bordered td { border: 1px solid #1a1a1a !important; background: transparent !important; }
    .table-bordered thead td { background: #111 !important; color: #fff !important; font-family: 'Orbitron'; font-size: 11px; }

</style>

<div id="product-info" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <div class="row">{{ column_left }}
    <div id="content" class="col">
      {{ content_top }}

      <div class="row mb-5">
        {% if thumb or images %}
          <div class="col-lg-6 mb-4">
            <div class="product-image-main magnific-popup">
              {% if thumb %}
                <a href="{{ popup }}" title="{{ heading_title }}">
                    <img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" class="img-fluid w-100"/>
                </a>
              {% endif %}

              {% if images %}
                <div class="additional-images d-flex flex-wrap gap-2 mt-3">
                  {% for image in images %}
                    <a href="{{ image.popup }}" title="{{ heading_title }}">
                        <img src="{{ image.thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}"/>
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <div class="col-lg-6">
          <h1>{{ heading_title }}</h1>

          <ul class="list-unstyled stats-list">
            {% if manufacturer %}
              <li><b>{{ text_manufacturer }}</b> <a href="{{ manufacturers }}">{{ manufacturer }}</a></li>
            {% endif %}
            <li><b>{{ text_model }}</b> <span style="color: #fff;">{{ model }}</span></li>
            {% for product_code in product_codes %}
              <li><b>{{ product_code.code }}:</b> {{ product_code.value }}</li>
            {% endfor %}
            <li><b>{{ text_stock }}</b> <span style="color: {% if 'In Stock' in stock or 'наявності' in stock %}#00ff00{% else %}#ff0000{% endif %};">{{ stock }}</span></li>
          </ul>

          {% if price %}
            <div class="price-block">
              <ul class="list-unstyled mb-0">
                {% if not special %}
                  <li><span class="price-new">{{ price }}</span></li>
                {% else %}
                  <li><span class="price-old">{{ price }}</span></li>
                  <li><span class="price-new">{{ special }}</span></li>
                {% endif %}
                {% if tax %}
                  <li style="font-size: 11px; color: #444; margin-top: 10px;">{{ text_tax }} {{ tax }}</li>
                {% endif %}
              </ul>
            </div>
          {% endif %}

          <div id="product">
            <form id="form-product">
              {% if options %}
                <div class="options-wrap mb-4" style="background: #0a0a0a; padding: 20px; border: 1px solid #1a1a1a;">
                  <h3 style="font-family: 'Orbitron'; font-size: 12px; color: #ff0000; margin-bottom: 20px;">[ SELECT_CONFIGURATION ]</h3>
                  {% for option in options %}
                    {# Тут логіка опцій як була, але селектори та інпути отримають стилі від загального CSS #}
                    {% if option.type == 'select' %}
                      <div class="mb-3{% if option.required %} required{% endif %}">
                        <label for="input-option-{{ option.product_option_id }}" class="form-label text-white-50 small uppercase">{{ option.name }}</label>
                        <select name="option[{{ option.product_option_id }}]" id="input-option-{{ option.product_option_id }}" class="form-select bg-black text-white border-dark">
                          <option value="">{{ text_select }}</option>
                          {% for option_value in option.product_option_value %}
                            <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }} {% if option_value.price %}({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}</option>
                          {% endfor %}
                        </select>
                      </div>
                    {% endif %}
                    {# ... інші типи опцій (radio, checkbox тощо) аналогічно стилізуються ... #}
                  {% endfor %}
                </div>
              {% endif %}

              <div class="buy-zone p-4" style="background: #000; border: 1px solid #1a1a1a;">
                <div class="row g-2 align-items-center">
                  <div class="col-sm-4">
                    <div class="input-group">
                      <span class="input-group-text bg-dark border-dark text-white-50 uppercase" style="font-size: 9px;">{{ entry_qty }}</span>
                      <input type="text" name="quantity" value="{{ minimum }}" id="input-quantity" class="form-control bg-black border-dark text-white text-center"/>
                    </div>
                  </div>
                  <div class="col-sm-8">
                    <button type="submit" id="button-cart" class="btn btn-primary w-100">
                        <i class="fa-solid fa-cart-plus me-2"></i> {{ button_cart }}
                    </button>
                  </div>
                </div>
                <input type="hidden" name="product_id" value="{{ product_id }}"/>
              </div>
            </form>
          </div>
        </div>
      </div>

      <ul class="nav nav-tabs">
        <li class="nav-item"><a href="#tab-description" data-bs-toggle="tab" class="nav-link active">{{ tab_description }}</a></li>
        {% if attribute_groups %}
          <li class="nav-item"><a href="#tab-specification" data-bs-toggle="tab" class="nav-link">{{ tab_attribute }}</a></li>
        {% endif %}
        {% if review_status %}
          <li class="nav-item"><a href="#tab-review" data-bs-toggle="tab" class="nav-link">{{ tab_review }}</a></li>
        {% endif %}
      </ul>

      <div class="tab-content">
        <div id="tab-description" class="tab-pane fade show active">
            <div class="description-content">
                {{ description }}
            </div>
            {% if tags %}
                <div class="mt-4 pt-3 border-top border-dark small">
                    <i class="fa-solid fa-tags me-2 color-red"></i> {{ text_tags }}
                    {% for tag in tags %}
                        <a href="{{ tag.href }}" class="text-white-50 text-decoration-none me-2">#{{ tag.tag }}</a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {% if attribute_groups %}
          <div id="tab-specification" class="tab-pane fade">
            <div class="table-responsive">
              <table class="table table-bordered mb-0">
                {% for attribute_group in attribute_groups %}
                  <thead>
                    <tr>
                      <td colspan="2"><strong>{{ attribute_group.name }}</strong></td>
                    </tr>
                  </thead>
                  <tbody>
                    {% for attribute in attribute_group.attribute %}
                      <tr>
                        <td width="30%">{{ attribute.name }}</td>
                        <td>{{ attribute.text }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                {% endfor %}
              </table>
            </div>
          </div>
        {% endif %}

        {% if review_status %}
          <div id="tab-review" class="tab-pane fade">
            <div id="review">{{ review }}</div>
          </div>
        {% endif %}
      </div>

      {{ related }}
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>

<script type="text/javascript"></script>
{{ footer }}