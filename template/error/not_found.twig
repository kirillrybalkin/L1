{{ header }}
<style>
    /* 1. СТИЛІЗАЦІЯ ХЛІБНИХ КРИХТ */
    .breadcrumb {
        background: transparent;
        padding: 10px 0;
        margin-bottom: 30px;
        border-bottom: 1px solid #1a1a1a;
    }
    .breadcrumb-item, .breadcrumb-item a {
        color: #444 !important;
        font-family: 'Consolas', monospace;
        font-size: 10px;
        text-transform: uppercase;
        text-decoration: none;
    }
    .breadcrumb-item.active { color: #ff0000 !important; }

    /* 2. ГОЛОВНИЙ БЛОК ПОМИЛКИ (CRITICAL_ALERT) */
    #error-not-found {
        min-height: 60vh;
        position: relative;
    }

    .error-terminal {
        background: #050505;
        border: 1px solid #ff0000;
        padding: 60px 40px;
        position: relative;
        overflow: hidden;
    }

    .error-code {
        font-family: 'Orbitron', sans-serif;
        font-size: 80px;
        font-weight: 900;
        color: rgba(255, 0, 0, 0.1);
        position: absolute;
        top: 20px;
        right: 20px;
        line-height: 1;
    }

    h1 {
        font-family: 'Orbitron', sans-serif;
        color: #ff0000;
        font-size: 24px;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 20px;
    }

    .error-text {
        font-family: 'Consolas', monospace;
        color: #888;
        font-size: 16px;
        margin-bottom: 40px;
        border-left: 2px solid #333;
        padding-left: 20px;
    }

    /* 3. КНОПКА ПЕРЕЗАВАНТАЖЕННЯ (REBOOT) */
    .btn-reboot {
        background: #ff0000 !important;
        color: #000 !important;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        padding: 15px 40px !important;
        border-radius: 0 !important;
        border: none !important;
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: 0.3s;
    }
    .btn-reboot:hover {
        background: #fff !important;
        box-shadow: 0 0 25px rgba(255, 0, 0, 0.5);
    }

    /* Декоративний гліч-ефект */
    .glitch-line {
        width: 100%;
        height: 1px;
        background: rgba(255, 0, 0, 0.2);
        position: absolute;
        left: 0;
        animation: glitch-anim 2s infinite;
    }
    @keyframes glitch-anim {
        0% { top: 0%; }
        100% { top: 100%; }
    }
</style>

<div id="error-not-found" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <div class="row">
    {{ column_left }}

    <div id="content" class="col">
      {{ content_top }}

      <div class="error-terminal">
        <div class="glitch-line"></div>
        <div class="error-code">404</div>

        <h1><i class="fa-solid fa-triangle-exclamation me-3"></i>{{ heading_title }}</h1>

        <div class="error-text">
            > [SYSTEM_REPORT]: RESOURCE_NOT_FOUND<br>
            > [LOCATION]: UNKNOWN_DATA_PATH<br>
            > [STATUS]: CRITICAL_DISCONNECT<br><br>
            {{ text_error }}
        </div>

        <div class="text-end">
          <a href="{{ continue }}" class="btn btn-reboot">
            <i class="fa-solid fa-power-off me-2"></i> REBOOT_SYSTEM_INTERFACE
          </a>
        </div>
      </div>

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>



{{ footer }}