{{ header }}

&lt;style&gt;
    /* 1. ГЛОБАЛЬНЫЙ ФОН И СТРУКТУРА */
    main {
        display: block;
        position: relative;
        z-index: 1;
        background-color: #0d0d0d;
    }

    #account-password {
        background-color: #0d0d0d !important;
        color: #eee !important;
        padding-top: 40px;
        padding-bottom: 80px;
        min-height: 75vh;
    }

    .breadcrumb { display: none !important; }

    /* 2. ЗАГОЛОВОК */
    h1 {
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        border-left: 5px solid #ff0000;
        padding-left: 20px;
        color: #fff;
        margin-bottom: 35px;
        font-size: 1.6rem;
    }

    /* 3. КАРТОЧКА ФОРМЫ */
    .password-card {
        background: #111;
        border: 1px solid #222;
        padding: 40px;
        border-top: 3px solid #ff0000;
    }

    .form-group { margin-bottom: 25px; }

    .form-label {
        color: #888;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
    }

    /* 4. ПОЛЯ ВВОДА */
    .form-control {
        background-color: #1a1a1a !important;
        border: 1px solid #333 !important;
        color: #fff !important;
        border-radius: 0 !important;
        padding: 12px 15px !important;
        transition: 0.3s;
    }

    .form-control:focus {
        border-color: #ff0000 !important;
        box-shadow: 0 0 10px rgba(255, 0, 0, 0.2) !important;
    }

    /* 5. КНОПКИ */
    .buttons {
        margin-top: 30px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .btn-primary {
        background-color: #ff0000 !important;
        border: 2px solid #ff0000 !important;
        border-radius: 0 !important;
        padding: 14px 35px !important;
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        font-weight: 900;
        color: #fff !important;
        transition: 0.3s all ease;
    }

    .btn-primary:hover {
        background-color: transparent !important;
        color: #ff0000 !important;
    }

    .btn-back-custom {
        background: transparent !important;
        border: 2px solid #333 !important;
        color: #666 !important;
        border-radius: 0 !important;
        padding: 14px 35px !important;
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        font-weight: 700;
        font-size: 13px;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s all ease;
    }

    .btn-back-custom:hover {
        border-color: #fff !important;
        background-color: #fff !important;
        color: #000 !important;
        transform: translateY(-2px);
    }

    /* 6. УВЕДОМЛЕНИЯ */
    .alert-garage {
        border-radius: 0 !important;
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        font-size: 13px;
        padding: 15px 20px;
        margin-bottom: 25px;
        display: none;
    }

    .alert-garage-error { background: #ff0000 !important; color: #fff !important; border-left: 5px solid #fff !important; }
    .alert-garage-success { background: #28a745 !important; color: #fff !important; border-left: 5px solid #fff !important; }

    .text-danger {
        color: #ff0000 !important;
        font-size: 11px;
        text-transform: uppercase;
        margin-top: 5px;
    }

    /* 7. ЛОГОТИП СПРАВА С ЭФФЕКТОМ */
    .password-sidebar-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        padding-left: 40px;
    }

    .password-sidebar-logo img {
        max-width: 100%;
        height: auto;
        filter: drop-shadow(0 0 15px rgba(255, 0, 0, 0.2));
        transition: 0.5s ease;
    }

    .password-sidebar-logo img:hover {
        filter: drop-shadow(0 0 25px rgba(255, 0, 0, 0.5));
        transform: scale(1.03);
    }

    .lang-block { display: none !important; }
&lt;/style&gt;

&lt;main&gt;
    &lt;div id=&quot;account-password&quot; class=&quot;container&quot;&gt;
        
        &lt;div id=&quot;alert-error&quot; class=&quot;alert alert-garage alert-garage-error&quot;&gt;
            &lt;i class=&quot;fa-solid fa-triangle-exclamation&quot; style=&quot;margin-right:10px;&quot;&gt;&lt;/i&gt;
            &lt;span class=&quot;lang-block lang-en&quot;&gt;Error: Please check the passwords!&lt;/span&gt;
            &lt;span class=&quot;lang-block lang-ua&quot;&gt;Помилка: Перевірте введені паролі!&lt;/span&gt;
            &lt;span class=&quot;lang-block lang-pl&quot;&gt;Błąd: Sprawdź wprowadzone hasła!&lt;/span&gt;
        &lt;/div&gt;

        &lt;div id=&quot;alert-success&quot; class=&quot;alert alert-garage alert-garage-success&quot;&gt;
            &lt;i class=&quot;fa-solid fa-circle-check&quot; style=&quot;margin-right:10px;&quot;&gt;&lt;/i&gt;
            &lt;span class=&quot;lang-block lang-en&quot;&gt;Success: Password changed!&lt;/span&gt;
            &lt;span class=&quot;lang-block lang-ua&quot;&gt;Успіх: Пароль змінено!&lt;/span&gt;
            &lt;span class=&quot;lang-block lang-pl&quot;&gt;Sukces: Hasło zostało zmienione!&lt;/span&gt;
        &lt;/div&gt;

        &lt;div class=&quot;row&quot;&gt;
            &lt;div id=&quot;content&quot; class=&quot;col-lg-7 col-md-12&quot;&gt;
                {{ content_top }}
                
                &lt;h1&gt;
                    &lt;span class=&quot;lang-block lang-en&quot;&gt;Change Password&lt;/span&gt;
                    &lt;span class=&quot;lang-block lang-ua&quot;&gt;Змінити пароль&lt;/span&gt;
                    &lt;span class=&quot;lang-block lang-pl&quot;&gt;Zmień hasło&lt;/span&gt;
                &lt;/h1&gt;

                &lt;div class=&quot;password-card&quot;&gt;
                    &lt;form action=&quot;{{ save }}&quot; method=&quot;post&quot; id=&quot;form-password&quot; data-oc-toggle=&quot;ajax&quot;&gt;
                        
                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;label class=&quot;form-label&quot;&gt;
                                &lt;span class=&quot;lang-block lang-en&quot;&gt;Password&lt;/span&gt;
                                &lt;span class=&quot;lang-block lang-ua&quot;&gt;Пароль&lt;/span&gt;
                                &lt;span class=&quot;lang-block lang-pl&quot;&gt;Hasło&lt;/span&gt;
                            &lt;/label&gt;
                            &lt;input type=&quot;password&quot; name=&quot;password&quot; value=&quot;{{ password }}&quot; id=&quot;input-password&quot; class=&quot;form-control&quot; placeholder=&quot;******&quot; /&gt;
                            &lt;div id=&quot;error-password&quot; class=&quot;text-danger&quot;&gt;&lt;/div&gt;
                        &lt;/div&gt;
                
                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;label class=&quot;form-label&quot;&gt;
                                &lt;span class=&quot;lang-block lang-en&quot;&gt;Password Confirm&lt;/span&gt;
                                &lt;span class=&quot;lang-block lang-ua&quot;&gt;Підтвердження пароля&lt;/span&gt;
                                &lt;span class=&quot;lang-block lang-pl&quot;&gt;Potwierdź hasło&lt;/span&gt;
                            &lt;/label&gt;
                            &lt;input type=&quot;password&quot; name=&quot;confirm&quot; value=&quot;{{ confirm }}&quot; id=&quot;input-confirm&quot; class=&quot;form-control&quot; placeholder=&quot;******&quot; /&gt;
                            &lt;div id=&quot;error-confirm&quot; class=&quot;text-danger&quot;&gt;&lt;/div&gt;
                        &lt;/div&gt;
                
                        &lt;div class=&quot;buttons&quot;&gt;
                            &lt;button type=&quot;submit&quot; class=&quot;btn btn-primary&quot;&gt;
                                &lt;span class=&quot;lang-block lang-en&quot;&gt;Update&lt;/span&gt;
                                &lt;span class=&quot;lang-block lang-ua&quot;&gt;Оновити&lt;/span&gt;
                                &lt;span class=&quot;lang-block lang-pl&quot;&gt;Aktualizuj&lt;/span&gt;
                            &lt;/button&gt;
                            
                            &lt;a href=&quot;{{ back }}&quot; class=&quot;btn-back-custom&quot;&gt;
                                &lt;i class=&quot;fa-solid fa-arrow-left&quot;&gt;&lt;/i&gt;
                                &lt;span class=&quot;lang-block lang-en&quot;&gt;Back&lt;/span&gt;
                                &lt;span class=&quot;lang-block lang-ua&quot;&gt;Назад&lt;/span&gt;
                                &lt;span class=&quot;lang-block lang-pl&quot;&gt;Powrót&lt;/span&gt;
                            &lt;/a&gt;
                        &lt;/div&gt;
                    &lt;/form&gt;
                &lt;/div&gt;
                {{ content_bottom }}
            &lt;/div&gt;

            &lt;div class=&quot;col-lg-5 d-none d-lg-flex align-items-center&quot;&gt;
                &lt;div class=&quot;password-sidebar-logo&quot;&gt;
                    &lt;img src=&quot;http://localhost/myshop/image/catalog/лого кар2.png&quot; alt=&quot;Logo&quot;&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/main&gt;

&lt;script&gt;
$(document).on('ajaxComplete', function(e, xhr, settings) {
    if (settings.url.indexOf('route=account/password\