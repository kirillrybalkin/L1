{{ header }}
<style>
    /* 1. ГЛОБАЛЬНЫЙ СТИЛЬ КОРЗИНЫ */
    #checkout-cart {
        background: #0a0a0a; color: #fff; padding-top: 40px;
        font-family: 'Orbitron', sans-serif; min-height: 100vh;
    }
    .breadcrumb { display: none !important; }

    /* 2. КОНТЕЙНЕР СПИСКА (QUEUE_MODULE) */
    #shopping-cart {
        background: #000; border: 1px solid #1a1a1a;
        padding: 5px; position: relative; margin-bottom: 40px;
    }
    #shopping-cart::before {
        content: "PRE_CHECKOUT_QUEUE_v4.2"; position: absolute; top: -22px; right: 0;
        font-size: 8px; color: #444; letter-spacing: 2px;
    }

    /* 3. СИСТЕМНЫЕ УВЕДОМЛЕНИЯ (ALERTS) */
    .alert {
        border-radius: 0 !important; border: none !important;
        font-family: 'Consolas', monospace; font-size: 12px;
        text-transform: uppercase; letter-spacing: 1px;
        margin-bottom: 20px;
    }
    .alert-success {
        background: #002200 !important; color: #00ff00 !important;
        border-left: 4px solid #00ff00 !important;
        box-shadow: inset 0 0 10px rgba(0,255,0,0.1);
    }
    .alert-danger {
        background: #220000 !important; color: #ff0000 !important;
        border-left: 4px solid #ff0000 !important;
        box-shadow: inset 0 0 10px rgba(255,0,0,0.1);
    }
    .btn-close { filter: invert(1); opacity: 0.5; }

    /* 4. ЭФФЕКТ ЗАГРУЗКИ */
    .btn-loading { pointer-events: none; opacity: 0.6; filter: grayscale(1); }
</style>

<div id="checkout-cart" class="container">
    <div class="row">
        {{ column_left }}
        <div id="content" class="col">
            {{ content_top }}

            <h1 class="mb-4">
                <i class="fa-solid fa-cart-flatbed-suitcases" style="color: #ff0000; margin-right: 15px;"></i>
                {{ heading_title }}
            </h1>

            <div id="shopping-cart">
                {{ list }}
            </div>

            {{ content_bottom }}
        </div>
        {{ column_right }}
    </div>
</div>



<script type="text/javascript"></script>
{{ footer }}