<div style="width: 100%; max-width: 600px; background-color: #050505; border: 1px solid #1a1a1a; margin-left: auto; margin-right: auto; padding: 0; font-family: 'Courier New', Courier, monospace; position: relative;">
  <table style="width: 100%; border-collapse: collapse; color: #eeeeee;">
    <thead>
      <tr>
        <td style="text-align: center; border-bottom: 2px solid #ff8800; padding: 25px;">
          {% if logo %}
            <a href="{{ store_url }}"><img src="{{ logo }}" alt="{{ store_name }}" title="{{ store_name }}" style="max-width: 180px; display: block; margin: 0 auto; filter: grayscale(1);"/></a>
          {% else %}
            <a href="{{ store_url }}" style="color: #ffffff; text-decoration: none; font-size: 20px; font-weight: bold; letter-spacing: 2px;">{{ store_name }}</a>
          {% endif %}
        </td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="padding: 30px; text-align: center;">
          <h1 style="color: #ff8800; font-family: Arial, sans-serif; font-size: 18px; text-transform: uppercase; letter-spacing: 3px; margin: 0;">
            [ {{ text_request }} ]
          </h1>
        </td>
      </tr>
      <tr>
        <td style="padding: 0 40px 40px 40px; line-height: 1.8; font-size: 14px;">

          <div style="border-left: 2px solid #ff8800; padding-left: 20px; margin-bottom: 30px; color: #888888;">
            <p style="color: #ffffff; font-weight: bold;">> {{ text_hello }}</p>
            <p>> [STATUS]: {{ text_delete }}</p>
            <p>> [NOTICE]: {{ text_contact }}</p>
          </div>

          <p style="text-align: center; margin: 40px 0;">
            <a href="{{ contact }}" style="display: inline-block; color: #ffffff; text-decoration: none; border: 1px solid #ff8800; background-color: transparent; padding: 12px 25px; font-family: Arial, sans-serif; font-size: 13px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase;">
              {{ button_contact }}
            </a>
          </p>

          <div style="border-top: 1px solid #1a1a1a; padding-top: 20px; color: #444444; font-size: 12px;">
            <p>
              {{ text_thanks }}<br/>
              <strong style="color: #ff8800; text-transform: uppercase;">{{ store_name }}</strong>
            </p>
          </div>
        </td>
      </tr>
    </tbody>
  </table>

  <div style="background-color: #1a0f00; padding: 10px; text-align: right; font-size: 8px; color: #ff8800; letter-spacing: 5px; opacity: 0.5;">
    CRITICAL_DATA_PURGE_v4.2
  </div>
</div>