{{ header }}

&lt;style&gt;
    /* 1. ГЛОБАЛЬНЫЙ ФОН И СТРУКТУРА */
    main {
        display: block;
        position: relative;
        z-index: 1;
        background-color: #0d0d0d;
    }

    #account-account {
        background-color: #0d0d0d !important;
        color: #eee !important;
        padding-top: 40px;
        padding-bottom: 80px;
        min-height: 75vh;
    }

    .breadcrumb { display: none !important; }

    /* 2. ЗАГОЛОВКИ СЕКЦИЙ */
    h1, h2 {
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        border-left: 5px solid #ff0000;
        padding-left: 20px;
        color: #fff;
        margin-bottom: 25px;
        margin-top: 35px;
        font-size: 1.4rem;
    }

    /* 3. КАРТОЧКИ-КНОПКИ */
    .account-link-list {
        padding: 0;
        margin-bottom: 40px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .account-link-list li { list-style: none; }

    .account-link-list li a {
        display: flex;
        align-items: center;
        background: #111;
        border: 1px solid #222;
        padding: 18px 20px;
        color: #ccc;
        text-decoration: none;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 1px;
        transition: 0.3s all ease;
        border-left: 3px solid transparent;
        height: 100%;
    }

    .account-link-list li a:hover {
        background: #1a1a1a;
        color: #ff0000;
        border-left: 3px solid #ff0000;
        padding-left: 25px;
    }

    /* 4. ПРАВАЯ ЧАСТЬ С ЛОГОТИПОМ */
    .account-sidebar-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        padding-left: 40px;
    }

    .account-sidebar-logo img {
        max-width: 100%;
        height: auto;
        filter: drop-shadow(0 0 15px rgba(255, 0, 0, 0.2));
        transition: 0.5s ease;
    }

    .account-sidebar-logo img:hover {
        filter: drop-shadow(0 0 25px rgba(255, 0, 0, 0.5));
        transform: scale(1.03);
    }

    /* 5. ЛОГИКА ПЕРЕВОДА */
    .lang-block { display: none !important; }
    body[data-lang=&quot;pl&quot;] .lang-pl { display: inline-block !important; }
    body[data-lang=&quot;ua&quot;] .lang-ua { display: inline-block !important; }
    body[data-lang=&quot;en&quot;] .lang-en { display: inline-block !important; }
    
    body[data-lang=&quot;pl&quot;] div.lang-pl { display: block !important; }
    body[data-lang=&quot;ua&quot;] div.lang-ua { display: block !important; }
    body[data-lang=&quot;en&quot;] div.lang-en { display: block !important; }

    @media (max-width: 991px) {
        .account-link-list { grid-template-columns: 1fr; }
        .account-sidebar-logo { display: none; }
    }
&lt;/style&gt;

&lt;main&gt;
    &lt;div id=&quot;account-account&quot; class=&quot;container&quot;&gt;
        {% if success %}
            &lt;div class=&quot;alert alert-success alert-dismissible&quot;&gt;&lt;i class=&quot;fa-solid fa-circle-check&quot;&gt;&lt;/i&gt; {{ success }}&lt;/div&gt;
        {% endif %}

        &lt;div class=&quot;row&quot;&gt;
            &lt;div id=&quot;content&quot; class=&quot;col-lg-7 col-md-12&quot;&gt;
                {{ content_top }}
                
                &lt;h1&gt;
                    &lt;span class=&quot;lang-block lang-en&quot;&gt;My Account&lt;/span&gt;
                    &lt;span class=&quot;lang-block lang-ua&quot;&gt;Мій Акаунт&lt;/span&gt;
                    &lt;span class=&quot;lang-block lang-pl&quot;&gt;Moje Konto&lt;/span&gt;
                &lt;/h1&gt;

                &lt;ul class=&quot;account-link-list&quot;&gt;
                    &lt;li&gt;&lt;a href=&quot;{{ edit }}&quot;&gt;&lt;span class=&quot;lang-block lang-en&quot;&gt;Edit account&lt;/span&gt;&lt;span class=&quot;lang-block lang-ua&quot;&gt;Редагувати акаунт&lt;/span&gt;&lt;span class=&quot;lang-block lang-pl&quot;&gt;Edytuj konto&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
                    &lt;li&gt;&lt;a href=&quot;{{ password }}&quot;&gt;&lt;span class=&quot;lang-block lang-en&quot;&gt;Password&lt;/span&gt;&lt;span class=&quot;lang-block lang-ua&quot;&gt;Пароль&lt;/span&gt;&lt;span class=&quot;lang-block lang-pl&quot;&gt;Hasło&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
                    &lt;li&gt;&lt;a href=&quot;{{ payment_method }}&quot;&gt;&lt;span class=&quot;lang-block lang-en&quot;&gt;Payments&lt;/span&gt;&lt;span class=&quot;lang-block lang-ua&quot;&gt;Оплати&lt;/span&gt;&lt;span class=&quot;lang-block lang-pl&quot;&gt;Płatności&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
                    &lt;li&gt;&lt;a href=&quot;{{ wishlist }}&quot;&gt;&lt;span class=&quot;lang-block lang-en&quot;&gt;Wish list&lt;/span&gt;&lt;span class=&quot;lang-block lang-ua&quot;&gt;Список бажань&lt;/span&gt;&lt;span class=&quot;lang-block lang-pl&quot;&gt;Lista życzeń&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
                &lt;/ul&gt;

                &lt;h2&gt;
                    &lt;span class=&quot;lang-block lang-en&quot;&gt;My Orders&lt;/span&gt;
                    &lt;span class=&quot;lang-block lang-ua&quot;&gt;Мої Замовлення&lt;/span&gt;
                    &lt;span class=&quot;lang-block lang-pl&quot;&gt;Moje Zamówienia&lt;/span&gt;
                &lt;/h2&gt;
                &lt;ul class=&quot;account-link-list&quot;&gt;
                    &lt;li&gt;&lt;a href=&quot;{{ order }}&quot;&gt;&lt;span class=&quot;lang-block lang-en&quot;&gt;Order history&lt;/span&gt;&lt;span class=&quot;lang-block lang-ua&quot;&gt;Історія замовлень&lt;/span&gt;&lt;span class=&quot;lang-block lang-pl&quot;&gt;Historia zamówień&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
                    &lt;li&gt;&lt;a href=&quot;{{ subscription }}&quot;&gt;&lt;span class=&quot;lang-block lang-en&quot;&gt;Subscriptions&lt;/span&gt;&lt;span class=&quot;lang-block lang-ua&quot;&gt;Передплати&lt;/span&gt;&lt;span class=&quot;lang-block lang-pl&quot;&gt;Subskrypcje&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
                    &lt;li&gt;&lt;a href=&quot;{{ download }}&quot;&gt;&lt;span class=&quot;lang-block lang-en&quot;&gt;Downloads&lt;/span&gt;&lt;span class=&quot;lang-block lang-ua&quot;&gt;Завантаження&lt;/span&gt;&lt;span class=&quot;lang-block lang-pl&quot;&gt;Pliki do pobrania&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
                    &lt;li&gt;&lt;a href=&quot;{{ return }}&quot;&gt;&lt;span class=&quot;lang-block lang-en&quot;&gt;Returns&lt;/span&gt;&lt;span class=&quot;lang-block lang-ua&quot;&gt;Повернення&lt;/span&gt;&lt;span class=&quot;lang-block lang-pl&quot;&gt;Zwроty&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
                    &lt;li&gt;&lt;a href=&quot;{{ transaction }}&quot;&gt;&lt;span class=&quot;lang-block lang-en&quot;&gt;Transactions&lt;/span&gt;&lt;span class=&quot;lang-block lang-ua&quot;&gt;Транзакції&lt;/span&gt;&lt;span class=&quot;lang-block lang-pl&quot;&gt;Transakcje&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
                &lt;/ul&gt;

                {{ content_bottom }}
            &lt;/div&gt;

            &lt;div class=&quot;col-lg-5 d-none d-lg-flex align-items-center&quot;&gt;
                &lt;div class=&quot;account-sidebar-logo&quot;&gt;
                    &lt;img src=&quot;http://localhost/myshop/image/catalog/лого кар2.png&quot; title=&quot;CarServiceGarage&quot; alt=&quot;CarServiceGarage&quot;&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/main&gt;

