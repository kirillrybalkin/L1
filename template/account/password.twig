{{ header }}
<style>
    /* 1. БАЗОВЫЙ СТИЛЬ */
    #account-password {
        background: #0a0a0a; color: #fff; padding-top: 40px;
        font-family: 'Orbitron', sans-serif; min-height: 100vh;
    }
    .breadcrumb { display: none !important; }

    /* 2. ЗАГОЛОВОК */
    h1 {
        font-size: 24px; font-weight: 900; text-transform: uppercase;
        letter-spacing: 2px; border-left: 5px solid #ff0000; padding-left: 20px; margin-bottom: 40px;
    }

    /* 3. МОДУЛЬ БЕЗОПАСНОСТИ */
    fieldset { border: 1px solid #1a1a1a; padding: 30px; background: #000; margin-bottom: 35px; position: relative; }
    legend {
        float: none; width: auto; padding: 0 15px; font-size: 11px;
        color: #ff0000; text-transform: uppercase; letter-spacing: 2px; font-weight: 900;
    }
    fieldset::before {
        content: "ENCRYPTION_v4.0_ACTIVE"; position: absolute; top: 10px; right: 15px;
        font-size: 8px; color: #333; letter-spacing: 2px;
    }

    .col-form-label { color: #666; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; }

    /* ПАРОЛЬ */
    .form-control {
        background-color: #050505 !important;
        border: 1px solid #333 !important;
        border-radius: 0 !important;
        color: #ff0000 !important; /* Красный ввод для пароля */
        font-family: 'Consolas', monospace;
        padding: 15px !important;
        transition: 0.3s;
        font-size: 18px !important;
    }
    .form-control:focus {
        border-color: #ff0000 !important;
        box-shadow: 0 0 15px rgba(255, 0, 0, 0.2) !important;
        background-color: #080808 !important;
    }
    .form-control::placeholder { color: #222; font-size: 10px; letter-spacing: 1px; }

    /* 4. КНОПКИ */
    .btn-garage-update {
        background: #ff0000; border: none; color: #000 !important;
        padding: 15px 40px; font-family: 'Orbitron'; font-size: 13px;
        font-weight: 900; text-transform: uppercase; letter-spacing: 2px;
        transition: 0.3s; border-radius: 0;
    }
    .btn-garage-update:hover { background: #fff; transform: translateY(-2px); box-shadow: 0 5px 20px rgba(255,0,0,0.4); }

    .btn-garage-back {
        background: transparent; border: 1px solid #333; color: #666 !important;
        padding: 15px 30px; font-family: 'Orbitron'; font-size: 11px;
        text-transform: uppercase; letter-spacing: 1px; transition: 0.3s;
        text-decoration: none; border-radius: 0; display: inline-block;
    }
    .btn-garage-back:hover { border-color: #ff0000; color: #fff !important; }

    /* ОШИБКИ */
    .invalid-feedback { color: #ff0000 !important; font-size: 9px !important; text-transform: uppercase; margin-top: 8px; font-weight: 900; }
</style>

<div id="account-password" class="container">
    <div class="row">
        {{ column_left }}
        <div id="content" class="col">
            {{ content_top }}

            <h1><i class="fa-solid fa-vault" style="color:#ff0000; margin-right:15px;"></i> {{ heading_title }}</h1>

            <form id="form-password" action="{{ save }}" method="post" data-oc-toggle="ajax">
                <fieldset>
                    <legend>[ {{ text_password }} ]</legend>

                    <div class="row mb-4 required">
                        <label for="input-password" class="col-md-3 col-form-label">{{ entry_password }}</label>
                        <div class="col-md-9">
                            <input type="password" name="password" value="{{ password }}" placeholder="NEW_SECURITY_KEY" id="input-password" class="form-control" autocomplete="new-password"/>
                            <div id="error-password" class="invalid-feedback"></div>
                        </div>
                    </div>

                    <div class="row mb-4 required">
                        <label for="input-confirm" class="col-md-3 col-form-label">{{ entry_confirm }}</label>
                        <div class="col-md-9">
                            <input type="password" name="confirm" value="{{ confirm }}" placeholder="CONFIRM_SECURITY_KEY" id="input-confirm" class="form-control"/>
                            <div id="error-confirm" class="invalid-feedback"></div>
                        </div>
                    </div>
                </fieldset>

                <div class="row mt-5 pt-4" style="border-top: 1px solid #1a1a1a;">
                    <div class="col">
                        <a href="{{ back }}" class="btn-garage-back">
                            <i class="fa-solid fa-xmark"></i>
                            <span data-lang-en="EXIT_WITHOUT_SAVE" data-lang-ua="ВИЙТИ БЕЗ ЗБЕРЕЖЕННЯ" data-lang-pl="WYJDŹ BEZ ZAPISYWANIA"></span>
                        </a>
                    </div>
                    <div class="col text-end">
                        <button type="submit" class="btn-garage-update">
                            <i class="fa-solid fa-shield-check"></i>
                            <span data-lang-en="UPDATE_SECURITY_KEY" data-lang-ua="ОНОВИТИ ПАРОЛЬ" data-lang-pl="ZAKTUALIZUJ HASŁO"></span>
                        </button>
                    </div>
                </div>
            </form>

            <div style="margin-top: 50px; text-align: center; opacity: 0.1;">
                <span style="font-size: 7px; letter-spacing: 8px;">SECURITY_SUBSYSTEM_v4.2_LOCKED</span>
            </div>

            {{ content_bottom }}
        </div>
        {{ column_right }}
    </div>
</div>
{{ footer }}