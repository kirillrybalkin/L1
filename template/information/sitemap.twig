{{ header }}
<style>
    /* 1. КОНТЕЙНЕР ТА ЗАГОЛОВОК */
    #information-sitemap h1 {
        font-family: 'Orbitron', sans-serif;
        color: #ff0000;
        text-transform: uppercase;
        letter-spacing: 3px;
        margin-bottom: 40px;
        border-left: 5px solid #ff0000;
        padding-left: 20px;
    }

    /* 2. СТИЛІЗАЦІЯ ДЕРЕВА (DIRECTORY_TREE) */
    #information-sitemap ul {
        list-style: none;
        padding-left: 25px;
        position: relative;
    }
    #information-sitemap ul ul {
        margin-top: 10px;
        border-left: 1px dashed #222;
    }

    #information-sitemap li {
        position: relative;
        margin-bottom: 12px;
        font-family: 'Consolas', monospace;
        font-size: 14px;
    }

    /* Візуальні гілки дерева */
    #information-sitemap li::before {
        content: "";
        position: absolute;
        top: 12px;
        left: -25px;
        width: 15px;
        height: 1px;
        background: #222;
    }

    /* 3. ПОСИЛАННЯ (FILE_NODES) */
    #information-sitemap a {
        color: #aaa !important;
        text-decoration: none;
        transition: 0.2s;
        display: inline-block;
        padding: 2px 8px;
    }
    #information-sitemap a:hover {
        color: #fff !important;
        background: rgba(255, 0, 0, 0.1);
        box-shadow: inset 3px 0 0 #ff0000;
    }

    /* Додаємо іконки через псевдоелементи */
    #information-sitemap a::before {
        content: "\f07b"; /* Folder icon */
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        margin-right: 10px;
        color: #333;
        font-size: 12px;
    }
    #information-sitemap ul ul a::before { content: "\f114"; /* Open folder */ }
    #information-sitemap ul ul ul a::before { content: "\f15b"; /* File icon */ color: #ff0000; opacity: 0.5; }

    /* 4. СЕКЦІЙНІ БЛОКИ */
    .sitemap-col {
        background: rgba(5, 5, 5, 0.5);
        border: 1px solid #111;
        padding: 30px;
        height: 100%;
    }
    .sitemap-header {
        font-family: 'Orbitron';
        font-size: 11px;
        color: #444;
        text-transform: uppercase;
        margin-bottom: 20px;
        display: block;
        letter-spacing: 2px;
    }
</style>

<div id="information-sitemap" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <div class="row">
    {{ column_left }}

    <div id="content" class="col">
      {{ content_top }}

      <h1><i class="fa-solid fa-sitemap me-3"></i>{{ heading_title }}</h1>

      <div class="row g-4">
        {# ЛІВА КОЛОНКА: КАТЕГОРІЇ #}
        <div class="col-sm-6">
          <div class="sitemap-col">
            <span class="sitemap-header">// CATALOG_STRUCTURE</span>
            <ul>
              {% for category_1 in categories %}
                <li>
                  <a href="{{ category_1.href }}">{{ category_1.name }}</a>
                  {% if category_1.children %}
                    <ul>
                      {% for category_2 in category_1.children %}
                        <li>
                          <a href="{{ category_2.href }}">{{ category_2.name }}</a>
                          {% if category_2.children %}
                            <ul>
                              {% for category_3 in category_2.children %}
                                <li><a href="{{ category_3.href }}">{{ category_3.name }}</a></li>
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>

        {# ПРАВА КОЛОНКА: СЕРВІСНІ СТОРІНКИ #}
        <div class="col-sm-6">
          <div class="sitemap-col">
            <span class="sitemap-header">// SYSTEM_UTILITIES</span>
            <ul>
              <li><a href="{{ special }}" style="color: #ff0000 !important;">{{ text_special }}</a></li>
              <li>
                <a href="{{ account }}">{{ text_account }}</a>
                <ul>
                  <li><a href="{{ edit }}">{{ text_edit }}</a></li>
                  <li><a href="{{ password }}">{{ text_password }}</a></li>
                  <li><a href="{{ address }}">{{ text_address }}</a></li>
                  <li><a href="{{ history }}">{{ text_history }}</a></li>
                  <li><a href="{{ download }}">{{ text_download }}</a></li>
                </ul>
              </li>
              <li><a href="{{ cart }}">{{ text_cart }}</a></li>
              <li><a href="{{ checkout }}">{{ text_checkout }}</a></li>
              <li><a href="{{ search }}">{{ text_search }}</a></li>
              <li>
                <span style="color:#444; font-size: 12px; margin-left: 10px;">{{ text_information }}</span>
                <ul>
                  {% for information in informations %}
                    <li><a href="{{ information.href }}">{{ information.title }}</a></li>
                  {% endfor %}
                  <li><a href="{{ contact }}">{{ text_contact }}</a></li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </div>

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>



{{ footer }}