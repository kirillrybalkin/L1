{{ header }}
<style>
    /* 1. ГЛОБАЛЬНЫЙ СТИЛЬ */
    #account-edit {
        background: #0a0a0a; color: #fff; padding-top: 40px;
        font-family: 'Orbitron', sans-serif; min-height: 100vh;
    }
    .breadcrumb { display: none !important; }

    /* 2. ЗАГОЛОВОК */
    h1 {
        font-size: 24px; font-weight: 900; text-transform: uppercase;
        letter-spacing: 2px; border-left: 5px solid #ff0000; padding-left: 20px; margin-bottom: 40px;
    }

    /* 3. ОФОРМЛЕНИЕ ФОРМЫ */
    fieldset { border: 1px solid #1a1a1a; padding: 25px; margin-bottom: 30px; background: #000; position: relative; }
    legend {
        float: none; width: auto; padding: 0 15px; font-size: 11px;
        color: #ff0000; text-transform: uppercase; letter-spacing: 2px; font-weight: 900;
    }

    .col-form-label { color: #666; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; }
    .required .col-form-label::after { content: " *"; color: #ff0000; }

    /* ИНПУТЫ */
    .form-control, .form-select {
        background-color: #050505 !important;
        border: 1px solid #333 !important;
        border-radius: 0 !important;
        color: #00ff00 !important;
        font-family: 'Consolas', monospace;
        padding: 12px !important;
        transition: 0.3s;
    }
    .form-control:focus, .form-select:focus {
        border-color: #ff0000 !important;
        box-shadow: 0 0 10px rgba(255,0,0,0.2) !important;
        background-color: #080808 !important;
    }
    .form-control::placeholder { color: #333; font-size: 9px; }

    /* 4. КНОПКИ */
    .btn-garage-update {
        background: #ff0000; border: none; color: #000 !important;
        padding: 15px 40px; font-family: 'Orbitron'; font-size: 13px;
        font-weight: 900; text-transform: uppercase; letter-spacing: 2px;
        transition: 0.3s; border-radius: 0;
    }
    .btn-garage-update:hover { background: #fff; transform: translateY(-2px); box-shadow: 0 5px 20px rgba(255,0,0,0.4); }

    .btn-garage-back {
        background: transparent; border: 1px solid #333; color: #666 !important;
        padding: 15px 30px; font-family: 'Orbitron'; font-size: 11px;
        text-transform: uppercase; letter-spacing: 1px; transition: 0.3s;
        text-decoration: none; border-radius: 0; display: inline-block;
    }
    .btn-garage-back:hover { border-color: #ff0000; color: #fff !important; }

    /* ОШИБКИ */
    .invalid-feedback { color: #ff0000 !important; font-size: 9px !important; text-transform: uppercase; margin-top: 5px; }

    /* CUSTOM FIELDS (RADIO/CHECKBOX) */
    .form-check-input { background-color: #111; border-color: #444; }
    .form-check-input:checked { background-color: #ff0000; border-color: #ff0000; }
    .form-check-label { color: #ccc; font-size: 12px; }
</style>

<div id="account-edit" class="container">
    <div class="row">
        {{ column_left }}
        <div id="content" class="col">
            {{ content_top }}
            <h1><i class="fa-solid fa-user-pen" style="color:#ff0000; margin-right:15px;"></i> {{ heading_title }}</h1>

            <form id="form-customer" action="{{ save }}" method="post" data-oc-toggle="ajax">
                <fieldset>
                    <legend>[ {{ text_your_details }} ]</legend>

                    <div class="row mb-4 required">
                        <label for="input-firstname" class="col-sm-3 col-form-label">{{ entry_firstname }}</label>
                        <div class="col-sm-9">
                            <input type="text" name="firstname" value="{{ firstname }}" placeholder="ENTER_FIRSTNAME" id="input-firstname" class="form-control"/>
                            <div id="error-firstname" class="invalid-feedback"></div>
                        </div>
                    </div>

                    <div class="row mb-4 required">
                        <label for="input-lastname" class="col-sm-3 col-form-label">{{ entry_lastname }}</label>
                        <div class="col-sm-9">
                            <input type="text" name="lastname" value="{{ lastname }}" placeholder="ENTER_LASTNAME" id="input-lastname" class="form-control"/>
                            <div id="error-lastname" class="invalid-feedback"></div>
                        </div>
                    </div>

                    <div class="row mb-4 required">
                        <label for="input-email" class="col-sm-3 col-form-label">{{ entry_email }}</label>
                        <div class="col-sm-9">
                            <input type="email" name="email" value="{{ email }}" placeholder="USER@DOMAIN.COM" id="input-email" class="form-control"/>
                            <div id="error-email" class="invalid-feedback"></div>
                        </div>
                    </div>

                    {% if config_telephone_display %}
                    <div class="row mb-4{% if config_telephone_required %} required{% endif %}">
                        <label for="input-telephone" class="col-sm-3 col-form-label">{{ entry_telephone }}</label>
                        <div class="col-sm-9">
                            <input type="tel" name="telephone" value="{{ telephone }}" placeholder="+380 / +48 ..." id="input-telephone" class="form-control"/>
                            <div id="error-telephone" class="invalid-feedback"></div>
                        </div>
                    </div>
                    {% endif %}
                </fieldset>

                {# CUSTOM FIELDS SECTION #}
                {% if custom_fields %}
                <fieldset>
                    <legend>[ ADDITIONAL_PARAMETERS ]</legend>
                    {% for custom_field in custom_fields %}
                        {# SELECT #}
                        {% if custom_field.type == 'select' %}
                        <div class="row mb-4{% if custom_field.required %} required{% endif %}">
                            <label for="input-custom-field-{{ custom_field.custom_field_id }}" class="col-sm-3 col-form-label">{{ custom_field.name }}</label>
                            <div class="col-sm-9">
                                <select name="custom_field[{{ custom_field.custom_field_id }}]" id="input-custom-field-{{ custom_field.custom_field_id }}" class="form-select">
                                    <option value="">{{ text_select }}</option>
                                    {% for custom_field_value in custom_field.custom_field_value %}
                                    <option value="{{ custom_field_value.custom_field_value_id }}"{% if account_custom_field[custom_field.custom_field_id] and custom_field_value.custom_field_value_id == account_custom_field[custom_field.custom_field_id] %} selected{% endif %}>{{ custom_field_value.name }}</option>
                                    {% endfor %}
                                </select>
                                <div id="error-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
                            </div>
                        </div>
                        {% endif %}

                        {# TEXT #}
                        {% if custom_field.type == 'text' %}
                        <div class="row mb-4{% if custom_field.required %} required{% endif %}">
                            <label for="input-custom-field-{{ custom_field.custom_field_id }}" class="col-sm-3 col-form-label">{{ custom_field.name }}</label>
                            <div class="col-sm-9">
                                <input type="text" name="custom_field[{{ custom_field.custom_field_id }}]" value="{% if account_custom_field[custom_field.custom_field_id] %}{{ account_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}" placeholder="{{ custom_field.name }}" id="input-custom-field-{{ custom_field.custom_field_id }}" class="form-control"/>
                                <div id="error-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
                            </div>
                        </div>
                        {% endif %}

                        {# Остальные типы полей обрабатываются аналогично... #}
                    {% endfor %}
                </fieldset>
                {% endif %}

                <div class="row mt-5 pt-4" style="border-top: 1px solid #1a1a1a;">
                    <div class="col">
                        <a href="{{ back }}" class="btn-garage-back"><i class="fa-solid fa-xmark"></i> CANCEL</a>
                    </div>
                    <div class="col text-end">
                        <button type="submit" class="btn-garage-update">
                            <i class="fa-solid fa-sync"></i> UPDATE_PROFILE
                        </button>
                    </div>
                </div>
            </form>

            {{ content_bottom }}
        </div>
        {{ column_right }}
    </div>
</div>
{{ footer }}