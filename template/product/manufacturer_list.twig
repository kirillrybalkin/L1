{{ header }}
<style>
    /* 1. ЗАГОЛОВОК ІНДЕКСУ */
    #product-manufacturer h1 {
        font-family: 'Orbitron', sans-serif;
        color: #ff0000;
        text-transform: uppercase;
        letter-spacing: 3px;
        margin-bottom: 30px;
        border-left: 5px solid #ff0000;
        padding-left: 20px;
    }

    /* 2. ШВИДКИЙ ВИБІР СЕКТОРУ (ALPHABET_SELECTOR) */
    .manufacturer-index {
        background: #0a0a0a;
        border: 1px solid #1a1a1a;
        padding: 15px;
        margin-bottom: 40px;
        font-family: 'Orbitron', sans-serif;
    }
    .manufacturer-index strong {
        color: #444;
        font-size: 10px;
        text-transform: uppercase;
        margin-right: 15px;
    }
    .manufacturer-index a {
        color: #888 !important;
        text-decoration: none;
        padding: 5px 10px;
        font-size: 13px;
        transition: 0.2s;
    }
    .manufacturer-index a:hover {
        color: #ff0000 !important;
        background: rgba(255, 0, 0, 0.1);
    }

    /* 3. СЕКЦІЇ ЛІТЕР (DATABASE_SECTORS) */
    .sector-title {
        font-family: 'Orbitron', sans-serif;
        color: #fff;
        background: #111;
        padding: 10px 20px;
        font-size: 20px;
        border-left: 3px solid #ff0000;
        margin: 40px 0 20px 0;
        display: inline-block;
        min-width: 60px;
        text-align: center;
    }

    /* 4. СПИСОК БРЕНДІВ (UNIT_NODES) */
    .manufacturer-node {
        font-family: 'Consolas', monospace;
        font-size: 15px;
        margin-bottom: 10px;
    }
    .manufacturer-node a {
        color: #aaa !important;
        text-decoration: none;
        display: block;
        padding: 5px 10px;
        border-bottom: 1px solid #111;
        transition: 0.3s;
    }
    .manufacturer-node a::before {
        content: "> ";
        color: #333;
    }
    .manufacturer-node a:hover {
        color: #ff0000 !important;
        background: #080808;
        padding-left: 20px;
        border-bottom-color: #ff0000;
    }
</style>

<div id="product-manufacturer" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <div class="row">
    {{ column_left }}

    <div id="content" class="col">
      {{ content_top }}

      <h1><i class="fa-solid fa-microchip me-3"></i>{{ heading_title }}</h1>

      {% if categories %}
        <div class="manufacturer-index">
          <strong><i class="fa-solid fa-search me-2"></i>{{ text_index }}</strong>
          {% for category in categories %}
            <a href="{{ category.href }}#{{ category.name }}">{{ category.name }}</a>
          {% endfor %}
        </div>

        {% for category in categories %}
          <div id="{{ category.name }}" class="sector-wrap">
            <h2 class="sector-title">{{ category.name }}</h2>

            {% if category.manufacturer %}
                <div class="row">
                {% for manufacturer in category.manufacturer %}
                  <div class="col-sm-3 manufacturer-node">
                    <a href="{{ manufacturer.href }}">{{ manufacturer.name }}</a>
                  </div>
                {% endfor %}
                </div>
            {% endif %}
          </div>
        {% endfor %}

      {% else %}
        <div class="category-info-wrap text-center py-5" style="background:#050505; border:1px solid #1a1a1a;">
            <p style="font-family: 'Orbitron'; color: #444;">[ NO_MANUFACTURER_DATA_LOADED ]</p>
            <div class="mt-4">
                <a href="{{ continue }}" class="btn btn-primary" style="background:#ff0000; border:none; border-radius:0; font-family:'Orbitron';">
                    {{ button_continue }}
                </a>
            </div>
        </div>
      {% endif %}

      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>

{{ footer }}