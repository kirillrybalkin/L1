{{ header }}

&lt;style&gt;
    main { display: block; position: relative; z-index: 1; background-color: #0d0d0d; }
    #account-address-form { background-color: #0d0d0d !important; color: #eee !important; padding-top: 40px; padding-bottom: 80px; min-height: 75vh; }
    .breadcrumb { display: none !important; }
    h1 { font-family: 'Orbitron', sans-serif; text-transform: uppercase; border-left: 5px solid #ff0000; padding-left: 20px; color: #fff; margin-bottom: 35px; font-size: 1.6rem; }
    .address-form-card { background: #111; border: 1px solid #222; padding: 40px; border-top: 3px solid #ff0000; }
    .form-group { margin-bottom: 20px; }

    .form-label { color: #888; text-transform: uppercase; font-size: 11px; letter-spacing: 1px; margin-bottom: 8px; display: block; }
    .form-control, .form-select { background-color: #1a1a1a !important; border: 1px solid #333 !important; color: #fff !important; border-radius: 0 !important; padding: 12px 15px !important; }
    .form-control:focus, .form-select:focus { border-color: #ff0000 !important; outline: none; }
    
    .text-danger { color: #ff0000 !important; font-size: 10px; text-transform: uppercase; margin-top: 5px; display: block; }

    .buttons-nav { margin-top: 30px; display: flex; justify-content: space-between; align-items: center; }
    .btn-primary-garage { background-color: #ff0000 !important; border: none !important; padding: 15px 35px !important; font-family: 'Orbitron', sans-serif; text-transform: uppercase; font-weight: 900; color: #fff !important; cursor: pointer; transition: 0.3s ease; width: 100%; }
    .btn-primary-garage:hover { background-color: #fff !important; color: #ff0000 !important; box-shadow: 0 0 20px rgba(255, 255, 255, 0.2); }
    
    .address-sidebar-logo img { 
        max-width: 100%; 
        filter: drop-shadow(0 0 5px rgba(255, 0, 0, 0.1)); 
        transition: all 0.5s ease; 
    }
    .address-sidebar-logo img:hover { 
        filter: drop-shadow(0 0 25px rgba(255, 0, 0, 1)) !important; 
        transform: scale(1.05); 
    }
&lt;/style&gt;

&lt;main&gt;
    &lt;div id=&quot;account-address-form&quot; class=&quot;container&quot;&gt;
        &lt;div class=&quot;row&quot;&gt;
            &lt;div id=&quot;content&quot; class=&quot;col-lg-7&quot;&gt;
                {{ content_top }}
                &lt;h1&gt;FORMULARZ ADRESU&lt;/h1&gt;

                &lt;div class=&quot;address-form-card&quot;&gt;
                    {# Убрали все лишние атрибуты, оставили только ID и action #}
                    &lt;form action=&quot;{{ save }}&quot; method=&quot;post&quot; id=&quot;form-garage-final&quot;&gt;
                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;label class=&quot;form-label&quot;&gt;Imię&lt;/label&gt;
                            &lt;input type=&quot;text&quot; name=&quot;firstname&quot; value=&quot;{{ firstname }}&quot; class=&quot;form-control&quot; /&gt;
                            &lt;div id=&quot;error-firstname&quot; class=&quot;text-danger&quot;&gt;&lt;/div&gt;
                        &lt;/div&gt;

                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;label class=&quot;form-label&quot;&gt;Nazwisko&lt;/label&gt;
                            &lt;input type=&quot;text&quot; name=&quot;lastname&quot; value=&quot;{{ lastname }}&quot; class=&quot;form-control&quot; /&gt;
                            &lt;div id=&quot;error-lastname&quot; class=&quot;text-danger&quot;&gt;&lt;/div&gt;
                        &lt;/div&gt;

                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;label class=&quot;form-label&quot;&gt;Firma&lt;/label&gt;
                            &lt;input type=&quot;text&quot; name=&quot;company&quot; value=&quot;{{ company }}&quot; class=&quot;form-control&quot; /&gt;
                        &lt;/div&gt;

                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;label class=&quot;form-label&quot;&gt;Adres&lt;/label&gt;
                            &lt;input type=&quot;text&quot; name=&quot;address_1&quot; value=&quot;{{ address_1 }}&quot; class=&quot;form-control&quot; /&gt;
                            &lt;div id=&quot;error-address-1&quot; class=&quot;text-danger&quot;&gt;&lt;/div&gt;
                        &lt;/div&gt;

                        &lt;div class=&quot;row&quot;&gt;
                            &lt;div class=&quot;col-sm-6&quot;&gt;
                                &lt;div class=&quot;form-group&quot;&gt;
                                    &lt;label class=&quot;form-label&quot;&gt;Miasto&lt;/label&gt;
                                    &lt;input type=&quot;text&quot; name=&quot;city&quot; value=&quot;{{ city }}&quot; class=&quot;form-control&quot; /&gt;
                                    &lt;div id=&quot;error-city&quot; class=&quot;text-danger&quot;&gt;&lt;/div&gt;
                                &lt;/div&gt;
                            &lt;/div&gt;
                            &lt;div class=&quot;col-sm-6&quot;&gt;
                                &lt;div class=&quot;form-group&quot;&gt;
                                    &lt;label class=&quot;form-label&quot;&gt;Kod pocztowy&lt;/label&gt;
                                    &lt;input type=&quot;text&quot; name=&quot;postcode&quot; value=&quot;{{ postcode }}&quot; class=&quot;form-control&quot; /&gt;
                                    &lt;div id=&quot;error-postcode&quot; class=&quot;text-danger&quot;&gt;&lt;/div&gt;
                                &lt;/div&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;

                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;label class=&quot;form-label&quot;&gt;Kraj&lt;/label&gt;
                            &lt;select name=&quot;country_id&quot; id=&quot;input-country&quot; class=&quot;form-select&quot;&gt;
                                &lt;option value=&quot;&quot;&gt; --- &lt;/option&gt;
                                {% for country in countries %}
                                    &lt;option value=&quot;{{ country.country_id }}&quot; {% if country.country_id == country_id %}selected{% endif %}&gt;{{ country.name }}&lt;/option&gt;
                                {% endfor %}
                            &lt;/select&gt;
                        &lt;/div&gt;

                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;label class=&quot;form-label&quot;&gt;Województwo&lt;/label&gt;
                            &lt;select name=&quot;zone_id&quot; id=&quot;input-zone&quot; class=&quot;form-select&quot;&gt;
                                &lt;option value=&quot;&quot;&gt; --- &lt;/option&gt;
                            &lt;/select&gt;
                        &lt;/div&gt;

                        &lt;div class=&quot;buttons-nav&quot;&gt;
                            {# Кнопка теперь просто кнопка, без типа submit внутри формы, чтобы избежать конфликтов #}
                            &lt;button type=&quot;button&quot; id=&quot;btn-save-manual&quot; class=&quot;btn-primary-garage&quot;&gt;ZAPISZ ADRES&lt;/button&gt;
                        &lt;/div&gt;
                    &lt;/form&gt;
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;div class=&quot;col-lg-5 d-none d-lg-flex align-items-center justify-content-center&quot;&gt;
                &lt;div class=&quot;address-sidebar-logo&quot;&gt;
                    &lt;img src=&quot;http://localhost/myshop/image/catalog/лого кар2.png&quot; alt=&quot;Garage Logo&quot;&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/main&gt;

