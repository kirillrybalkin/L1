<div style="width: 100%; max-width: 600px; background-color: #050505; border: 1px solid #1a1a1a; margin-left: auto; margin-right: auto; padding: 0; font-family: 'Courier New', Courier, monospace;">
  <table style="width: 100%; border-collapse: collapse; color: #eeeeee;">
    <thead>
      <tr>
        <td style="text-align: center; border-bottom: 2px solid #ff0000; padding: 25px;">
          {% if logo %}
            <a href="{{ store_url }}"><img src="{{ logo }}" alt="{{ store_name }}" title="{{ store_name }}" style="max-width: 200px; display: block; margin: 0 auto;"/></a>
          {% else %}
            <a href="{{ store_url }}" style="color: #ffffff; text-decoration: none; font-size: 20px; font-weight: bold; letter-spacing: 2px;">{{ store_name }}</a>
          {% endif %}
        </td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="padding: 30px; text-align: center;">
          <h1 style="color: #ff0000; font-family: Arial, sans-serif; font-size: 18px; text-transform: uppercase; letter-spacing: 2px; margin: 0;">
            [ {{ text_request }} ]
          </h1>
        </td>
      </tr>
      <tr>
        <td style="padding: 0 40px 40px 40px; line-height: 1.6; font-size: 14px;">

          <div style="background: #0a0a0a; border-left: 3px solid #333; padding: 20px; margin-bottom: 35px; color: #aaaaaa;">
            {{ text_gdpr }}
          </div>

          <p style="text-align: center; margin-bottom: 40px;">
            <a href="{{ confirm }}" style="display: inline-block; color: #000000; text-decoration: none; background-color: #ff0000; padding: 15px 30px; font-family: Arial, sans-serif; font-size: 14px; font-weight: 900; letter-spacing: 2px; text-transform: uppercase;">
              {{ button_confirm }}
            </a>
          </p>

          <p style="color: #444444; font-size: 12px; margin-bottom: 30px; border-top: 1px solid #1a1a1a; padding-top: 20px;">
            > [NOTICE]: {{ text_ignore }}
          </p>

          <p style="margin: 0; color: #666666;">
            {{ text_thanks }}<br/>
            <strong style="color: #ff0000; font-size: 16px;">{{ store_name }}</strong>
          </p>
        </td>
      </tr>
    </tbody>
  </table>

  <div style="background-color: #111; padding: 10px; text-align: right; font-size: 8px; color: #333; letter-spacing: 5px;">
    GDPR_ENCRYPTION_LAYER_v4.2
  </div>
</div>