{{ header }}
<style>
    /* 1. СТИЛІЗАЦІЯ ГОЛОВНОЇ ПАНЕЛІ (DASHBOARD) */
    #common-home {
        padding-top: 20px;
        padding-bottom: 60px;
        min-height: 80vh;
        position: relative;
    }

    /* Фоновий ефект системної сітки */
    #common-home::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 50px 50px;
        pointer-events: none;
        z-index: -1;
    }

    /* 2. КОНТЕЙНЕР КОНТЕНТУ */
    #content {
        position: relative;
    }

    /* Декоративний індикатор активності системи в кутку */
    .system-status-indicator {
        position: absolute;
        top: -10px;
        right: 15px;
        font-family: 'Orbitron', sans-serif;
        font-size: 8px;
        color: #444;
        letter-spacing: 2px;
        text-transform: uppercase;
    }
    .status-blink {
        display: inline-block;
        width: 6px;
        height: 6px;
        background: #00ff00;
        border-radius: 50%;
        margin-right: 5px;
        box-shadow: 0 0 5px #00ff00;
        animation: blink 1.5s infinite;
    }

    @keyframes blink {
        0% { opacity: 0.2; }
        50% { opacity: 1; }
        100% { opacity: 0.2; }
    }

    /* Відступи між верхніми та нижніми модулями */
    #content > *:not(:last-child) {
        margin-bottom: 50px;
    }
</style>

<div id="common-home" class="container">
  <div class="system-status-indicator">
    <span class="status-blink"></span> SYSTEM_LIVE / {{ lang|upper }} / PRO3_ENGINE_v4
  </div>

  <div class="row">
    {{ column_left }}

    <div id="content" class="col">
        {# Тут виводяться Слайдери, Банери (PRIMARY_MODULES) #}
        {{ content_top }}

        {# Тут виводяться Товари, Каруселі (DATA_MODULES) #}
        {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>



{{ footer }}