{% if products %}
  <div class="related-products-module mt-5 pt-5 border-top border-dark">
    <h3 style="font-family: 'Orbitron', sans-serif; color: #ff0000; font-size: 18px; text-transform: uppercase; letter-spacing: 3px; margin-bottom: 30px; display: flex; align-items: center;">
        <span style="background: #ff0000; color: #000; padding: 2px 10px; margin-right: 15px; font-size: 12px;">PRO3</span>
        {{ text_related }}
        <span style="flex-grow: 1; height: 1px; background: linear-gradient(to right, #ff0000, transparent); margin-left: 20px; opacity: 0.3;"></span>
    </h3>

    <div id="product-related" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
      {% for product in products %}
        <div class="col mb-3">
            <div class="related-unit-wrapper" style="border: 1px solid #1a1a1a; transition: 0.3s;">
                {{ product }}
            </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <style>
    .related-unit-wrapper:hover {
        border-color: #ff0000;
        box-shadow: 0 0 15px rgba(255, 0, 0, 0.1);
    }
    #product-related .col {
        position: relative;
    }
  </style>
{% endif %}