<div style="background-color: #050505; color: #aaaaaa; font-family: 'Courier New', Courier, monospace; padding: 30px; border: 1px solid #1a1a1a; max-width: 600px; margin: 0 auto;">
  
  <div style="background-color: #ff0000; color: #000000; padding: 12px 20px; font-weight: bold; font-size: 14px; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 25px; text-align: center;">
    [!] {{ text_received }}
  </div>

  <div style="background-color: #0a0a0a; border: 1px solid #222222; padding: 20px; margin-bottom: 20px;">
    <table width="100%" cellpadding="6" cellspacing="0" style="font-family: 'Courier New', Courier, monospace; font-size: 13px;">
      <tr>
        <td width="180" style="color: #444444; border-bottom: 1px solid #111;">{{ text_orders_id }}</td>
        <td style="color: #ffffff; border-bottom: 1px solid #111; font-weight: bold;">#{{ order_id }}</td>
      </tr>
      <tr>
        <td style="color: #444444; border-bottom: 1px solid #111;">{{ text_subscription_id }}</td>
        <td style="color: #ff0000; border-bottom: 1px solid #111;">ID_{{ subscription_id }}</td>
      </tr>
      <tr>
        <td style="color: #444444; border-bottom: 1px solid #111;">{{ text_date_added }}</td>
        <td style="color: #ffffff; border-bottom: 1px solid #111;">{{ date_added }}</td>
      </tr>
      <tr>
        <td style="color: #444444; border-bottom: 1px solid #111;">{{ text_subscription_status }}</td>
        <td style="color: #00ff00; border-bottom: 1px solid #111; font-weight: bold;">{{ subscription_status }}</td>
      </tr>
    </table>
  </div>

  {% if comment %}
    <div style="border: 1px dashed #333333; padding: 20px; background-color: #0c0c0c; margin-top: 20px;">
      <p style="color: #ff0000; font-weight: bold; font-size: 11px; margin-top: 0; text-transform: uppercase;">> [{{ text_comment }}]:</p>
      <p style="color: #eeeeee; font-size: 13px; line-height: 1.5; margin-bottom: 0;">{{ comment }}</p>
    </div>
  {% endif %}

  <div style="margin-top: 30px; text-align: right; font-size: 8px; color: #222222; letter-spacing: 4px; text-transform: uppercase;">
    RECURRING_EVENT_DETECTION // DATA_STREAM_v4.2
  </div>
</div>