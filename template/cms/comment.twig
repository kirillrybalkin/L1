<style>
    /* 1. ПАНЕЛЬ ДІЙ (ACTION BAR) */
    .comment-actions {
        background: #000;
        padding: 20px;
        border: 1px solid #1a1a1a;
        margin-bottom: 30px;
    }
    .btn-system-sm {
        background: #111;
        border: 1px solid #333;
        color: #888;
        font-family: 'Orbitron', sans-serif;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 0;
        transition: 0.3s;
        margin: 0 5px;
    }
    .btn-system-sm:hover {
        background: #ff0000;
        color: #000;
        border-color: #ff0000;
        box-shadow: 0 0 10px rgba(255,0,0,0.3);
    }

    /* 2. СОРТУВАННЯ ТА ЗАГОЛОВОК */
    h2 {
        font-size: 18px;
        color: #ff0000;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin: 0;
    }
    .sort-terminal .input-group-text {
        background: #050505;
        border: 1px solid #222;
        color: #444;
        font-size: 9px;
        text-transform: uppercase;
    }
    .sort-terminal .form-select {
        background: #000 !important;
        border: 1px solid #222 !important;
        color: #00ff00 !important;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        border-radius: 0;
    }

    /* 3. МОДАЛЬНЕ ВІКНО (REPORT_MODAL) */
    .modal-content {
        background: #0a0a0a !important;
        border: 1px solid #ff0000 !important;
        border-radius: 0 !important;
    }
    .modal-header {
        border-bottom: 1px solid #1a1a1a;
    }
    .modal-title {
        color: #ff0000;
        font-family: 'Orbitron';
        font-size: 14px;
        text-transform: uppercase;
    }
    .modal-body label {
        color: #444;
        font-size: 10px;
        text-transform: uppercase;
    }
    .modal-body .form-control {
        background: #000 !important;
        border: 1px solid #222 !important;
        color: #00ff00 !important;
        font-family: 'Consolas', monospace;
        border-radius: 0;
    }
    .modal-body .form-control:focus {
        border-color: #ff0000;
        box-shadow: none;
    }
    .btn-close { filter: invert(1); }

    .btn-submit-report {
        background: #ff0000 !important;
        color: #000 !important;
        font-family: 'Orbitron';
        font-weight: 900;
        border-radius: 0;
        border: none;
        width: 100%;
        text-transform: uppercase;
    }
</style>

<div class="comment-actions text-center">
  {% if logged %}
    <button type="button" value="{{ like }}" data-bs-toggle="tooltip" title="{{ button_like }}" data-oc-toggle="rate" class="btn btn-system-sm"><i class="fa-solid fa-arrow-up"></i> SYSTEM_UP</button>
    <button type="button" value="{{ dislike }}" data-bs-toggle="tooltip" title="{{ button_dislike }}" data-oc-toggle="rate" class="btn btn-system-sm"><i class="fa-solid fa-arrow-down"></i> SYSTEM_DOWN</button>
    <button type="button" value="{{ comment_add }}" data-oc-toggle="comment" data-oc-target="#comment-0" data-oc-trigger="#button-refresh" class="btn btn-system-sm" style="color:#ff0000;">
        <i class="fa-solid fa-pen-to-square"></i> WRITE_REPORT
    </button>
  {% else %}
    <a href="{{ login }}" class="btn btn-system-sm"><i class="fa-solid fa-arrow-up"></i></a>
    <a href="{{ login }}" class="btn btn-system-sm"><i class="fa-solid fa-arrow-down"></i></a>
    <a href="{{ login }}" class="btn btn-system-sm" style="color:#ff0000;">{{ button_login }}</a>
  {% endif %}
</div>

<hr style="border-color: #1a1a1a;"/>

<div class="row mb-4 align-items-center">
  <div class="col">
    <h2><i class="fa-solid fa-comments me-2"></i> {{ heading_title }}</h2>
  </div>
  <div class="col-md-4 sort-terminal">
    <div class="input-group">
      <label for="input-sort" class="input-group-text">{{ text_sort }}</label>
      <select id="input-sort" class="form-select">
        {% for sorts in sorts %}
          <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts.text }}</option>
        {% endfor %}
      </select>
    </div>
  </div>
</div>

<div id="comment">{{ list }}</div>

{# MODAL_INTERFACE #}
<div id="modal-comment" class="modal fade">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fa-solid fa-terminal me-2"></i> WRITE_SYSTEM_REPORT</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="form-comment" action="" data-oc-target="" data-oc-trigger="">
          <div class="mb-3 required">
            <label for="input-author" class="form-label">{{ entry_author }}</label>
            <input type="text" name="author" value="{{ author }}" placeholder="OPERATOR_ID" id="input-author" class="form-control"/>
            <div id="error-author" class="invalid-feedback"></div>
          </div>
          <div class="mb-3 required">
            <label for="input-comment" class="form-label">{{ entry_comment }}</label>
            <textarea name="comment" rows="5" placeholder="ENTER_TECHNICAL_DETAILS..." id="input-comment" class="form-control">{{ comment }}</textarea>
            <div id="error-comment" class="invalid-feedback"></div>
          </div>
          {{ captcha }}
        </form>
      </div>
      <div class="modal-footer" style="border-top: 1px solid #1a1a1a;">
        <button type="submit" id="button-comment" form="form-comment" class="btn btn-submit-report">{{ button_comment }}</button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"></script>