{{ header }}
<style>
    /* 1. КОНТЕЙНЕР */
    #content {
        background: #0a0a0a;
        min-height: 80vh;
        display: flex;
        align-items: center;
        font-family: 'Orbitron', sans-serif;
    }

    /* 2. ТЕРМІНАЛ УСПІХУ */
    .unlock-terminal {
        background: #000;
        border: 1px solid #111;
        border-top: 5px solid #00ff00; /* Зелений колір успіху */
        padding: 50px 40px;
        text-align: center;
        box-shadow: 0 0 40px rgba(0, 255, 0, 0.1);
        position: relative;
    }
    .unlock-terminal::before {
        content: "STATUS: ACCESS_GRANTED";
        position: absolute;
        top: 15px;
        left: 20px;
        font-size: 8px;
        color: #00ff00;
        letter-spacing: 2px;
    }

    .card-header {
        background: transparent !important;
        border: none !important;
        color: #fff !important;
        font-size: 20px !important;
        font-weight: 900 !important;
        text-transform: uppercase !important;
        letter-spacing: 4px !important;
        margin-bottom: 10px !important;
    }

    .card-body p {
        color: #00ff00;
        font-family: 'Consolas', monospace;
        font-size: 13px;
        text-transform: uppercase;
        margin-bottom: 35px;
        background: rgba(0, 255, 0, 0.05);
        padding: 10px;
        border: 1px dashed rgba(0, 255, 0, 0.2);
    }

    /* 3. КНОПКА LOGIN */
    .btn-login-restored {
        background: #00ff00 !important;
        border: none !important;
        color: #000 !important;
        font-weight: 900 !important;
        font-family: 'Orbitron' !important;
        text-transform: uppercase !important;
        letter-spacing: 2px !important;
        padding: 18px 40px !important;
        font-size: 14px !important;
        transition: 0.3s !important;
        text-decoration: none;
        display: inline-block;
        width: 100%;
    }
    .btn-login-restored:hover {
        background: #fff !important;
        box-shadow: 0 0 20px rgba(0, 255, 0, 0.5);
        transform: translateY(-2px);
    }

    /* 4. ДЕКОР */
    .success-icon {
        font-size: 60px;
        color: #00ff00;
        margin-bottom: 25px;
        filter: drop-shadow(0 0 10px rgba(0, 255, 0, 0.4));
    }
</style>

<div id="content">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-sm-10 col-md-8 col-lg-5">

        <div class="unlock-terminal">
          <div class="success-icon">
            <i class="fa-solid fa-shield-check"></i>
          </div>

          <div class="card-header">
            {{ text_unlocked }}
          </div>

          <div class="card-body">
            <p>> {{ text_unlock }}</p>

            <div class="d-grid">
              <a href="{{ login }}" class="btn-login-restored">
                <i class="fa-solid fa-right-to-bracket"></i> INITIALIZE_LOGIN
              </a>
            </div>
          </div>

          <div style="margin-top: 30px; opacity: 0.5;">
             <span style="font-size: 7px; color: #00ff00; letter-spacing: 4px;">CONNECTION_SECURE_100%</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
{{ footer }}