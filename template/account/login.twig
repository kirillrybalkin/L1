{{ header }}
<style>
    /* 1. ГЛОБАЛЬНЫЙ СТИЛЬ СТРАНИЦЫ ВХОДА */
    #account-login {
        background: #0a0a0a; color: #fff; padding-top: 50px;
        font-family: 'Orbitron', sans-serif; min-height: 100vh;
    }
    .breadcrumb { display: none !important; }

    /* 2. ЗАГОЛОВКИ БЛОКОВ */
    h2 {
        font-size: 18px; font-weight: 900; text-transform: uppercase;
        letter-spacing: 2px; color: #ff0000; margin-bottom: 25px;
        border-bottom: 1px solid #1a1a1a; padding-bottom: 10px;
    }

    /* 3. ДИЗАЙН КАРТОЧЕК */
    .login-box {
        background: #000; border: 1px solid #222;
        padding: 30px; height: 100%; transition: 0.3s;
        position: relative;
    }
    .login-box:hover { border-color: #444; box-shadow: 0 0 20px rgba(255,0,0,0.1); }

    .login-box::before {
        content: "DEVICE_AUTH_v4.0"; position: absolute; top: 10px; right: 15px;
        font-size: 7px; color: #333; letter-spacing: 2px;
    }

    /* 4. ПОЛЯ ВВОДА */
    .col-form-label { color: #888; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; }

    .form-control {
        background-color: #050505 !important;
        border: 1px solid #333 !important;
        border-radius: 0 !important;
        color: #00ff00 !important;
        font-family: 'Consolas', monospace;
        padding: 12px !important;
        transition: 0.3s;
    }
    .form-control:focus {
        border-color: #ff0000 !important;
        box-shadow: 0 0 10px rgba(255,0,0,0.2) !important;
    }

    /* 5. КНОПКИ */
    .btn-garage-primary {
        background: #ff0000; border: none; color: #000 !important;
        padding: 15px 30px; font-family: 'Orbitron'; font-size: 12px;
        font-weight: 900; text-transform: uppercase; letter-spacing: 2px;
        transition: 0.3s; width: 100%; border-radius: 0;
    }
    .btn-garage-primary:hover { background: #fff; transform: translateY(-2px); }

    .btn-garage-outline {
        background: transparent; border: 1px solid #333; color: #fff !important;
        padding: 15px 30px; font-family: 'Orbitron'; font-size: 12px;
        text-transform: uppercase; letter-spacing: 2px; transition: 0.3s;
        text-decoration: none; display: block; text-align: center; border-radius: 0;
    }
    .btn-garage-outline:hover { border-color: #ff0000; background: rgba(255,0,0,0.05); }

    /* Ссылка на забытый пароль */
    .forgotten-link { color: #666; font-size: 10px; text-decoration: none; text-transform: uppercase; transition: 0.3s; }
    .forgotten-link:hover { color: #ff0000; }

    /* АЛЕРТЫ */
    .alert { border-radius: 0; border: none; font-size: 11px; text-transform: uppercase; }
    .alert-success { background: #002200; color: #00ff00; border-left: 4px solid #00ff00; }
    .alert-danger { background: #220000; color: #ff0000; border-left: 4px solid #ff0000; }
</style>

<div id="account-login" class="container">
    {# СИСТЕМНЫЕ УВЕДОМЛЕНИЯ #}
    {% if success %}
        <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }}</div>
    {% endif %}
    {% if error_warning %}
        <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}</div>
    {% endif %}

    <div class="row">
        {{ column_left }}
        <div id="content" class="col">
            {{ content_top }}

            <div class="row">
                {# БЛОК РЕГИСТРАЦИИ #}
                <div class="col-lg-6 mb-4">
                    <div class="login-box d-flex flex-column justify-content-between">
                        <div>
                            <h2>{{ text_new_customer }}</h2>
                            <p style="color: #666; font-size: 12px; margin-bottom: 20px;">
                                <i class="fa-solid fa-microchip" style="color:#ff0000; margin-right:10px;"></i>
                                <strong>{{ text_register }}</strong>
                            </p>
                            <p style="color: #888; font-size: 13px; line-height: 1.6;">{{ text_register_account }}</p>
                        </div>
                        <div class="mt-4">
                            <a href="{{ register }}" class="btn-garage-outline">
                                <span data-lang-en="CREATE_ACCOUNT" data-lang-ua="СТВОРИТИ АККАУНТ" data-lang-pl="UTWÓRZ KONTO"></span>
                            </a>
                        </div>
                    </div>
                </div>

                {# БЛОК ВХОДА #}
                <div class="col-lg-6 mb-4">
                    <div class="login-box">
                        <form id="form-login" action="{{ login }}" method="post" data-oc-toggle="ajax">
                            <h2>{{ text_returning_customer }}</h2>
                            <p style="color: #666; font-size: 12px; margin-bottom: 25px;">
                                <i class="fa-solid fa-key" style="color:#ff0000; margin-right:10px;"></i>
                                <strong>{{ text_i_am_returning_customer }}</strong>
                            </p>

                            <div class="mb-4">
                                <label for="input-email" class="col-form-label">{{ entry_email }}</label>
                                <input type="email" name="email" value="{{ email }}" placeholder="USER@TERMINAL.COM" id="input-email" class="form-control"/>
                            </div>

                            <div class="mb-4">
                                <div class="d-flex justify-content-between">
                                    <label for="input-password" class="col-form-label">{{ entry_password }}</label>
                                    <a href="{{ forgotten }}" class="forgotten-link">{{ text_forgotten }}</a>
                                </div>
                                <input type="password" name="password" value="{{ password }}" placeholder="••••••••" id="input-password" class="form-control"/>
                            </div>

                            {% if redirect %}
                                <input type="hidden" name="redirect" value="{{ redirect }}"/>
                            {% endif %}

                            <div class="mt-5">
                                <button type="submit" class="btn-garage-primary">
                                    <i class="fa-solid fa-right-to-bracket"></i> START_SESSION
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            {{ content_bottom }}
        </div>
        {{ column_right }}
    </div>
</div>



{{ footer }}