<div style="background-color: #0a0a0a; color: #eeeeee; font-family: 'Courier New', Courier, monospace; padding: 40px; line-height: 1.6; border: 1px solid #1a1a1a;">
  
  <div style="border-bottom: 2px solid #ff0000; padding-bottom: 20px; margin-bottom: 30px;">
    <span style="font-family: Arial, sans-serif; font-weight: 900; color: #ffffff; font-size: 18px; letter-spacing: 2px;">
      LAUNCH PRO3 // PARTNER_PROTOCOL
    </span>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="color: #ff0000; font-weight: bold; font-size: 14px;">> [SYSTEM_MESSAGE]:</p>
    <p style="font-size: 16px;">{{ text_welcome }}</p>
  </div>

  {% if not approval %}
    <div style="background: #111111; border-left: 4px solid #ff0000; padding: 20px; margin-bottom: 30px;">
      <p style="margin-top: 0; color: #888888; font-size: 12px;">{{ text_login }}</p>
      <a href="{{ login }}" style="color: #ffffff; text-decoration: none; font-weight: bold; font-size: 14px; background: #333333; padding: 10px 20px; display: inline-block;">
        ACCESS_PARTNER_PANEL_v4.2
      </a>
    </div>

    <div style="color: #888888; font-size: 13px; margin-bottom: 30px;">
      <p>> {{ text_service }}</p>
    </div>

    <div style="border-top: 1px solid #222222; padding-top: 20px;">
      <p style="font-size: 12px; color: #444444;">
        {{ text_thanks }}<br/>
        <strong style="color: #ff0000;">{{ store }}</strong>
      </p>
    </div>

  {% else %}
    <div style="background: #1a0f00; border: 1px solid #ff8800; padding: 20px; margin-bottom: 30px; color: #ff8800;">
      <p style="margin: 0;">[!] {{ text_approval }}</p>
    </div>

    <div style="margin-bottom: 30px;">
      <p style="color: #888888;">{{ login }}</p>
    </div>

    <div style="border-top: 1px solid #222222; padding-top: 20px;">
      <p style="font-size: 12px; color: #444444;">
        {{ text_thanks }}<br/>
        <strong style="color: #ff0000;">{{ store }}</strong><br/>
        <small>{{ store_url }}</small>
      </p>
    </div>
  {% endif %}

  <div style="margin-top: 40px; text-align: right; opacity: 0.2; font-size: 10px; letter-spacing: 5px;">
    DATA_ENCRYPTED_AES256
  </div>
</div>