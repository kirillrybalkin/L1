<div style="background-color: #050505; color: #aaaaaa; font-family: 'Courier New', Courier, monospace; padding: 40px; border: 1px solid #1a1a1a; max-width: 600px; margin: 0 auto;">
  
  <div style="border-bottom: 2px solid #ff0000; padding-bottom: 20px; margin-bottom: 30px;">
    <span style="color: #ffffff; font-weight: bold; font-size: 18px; letter-spacing: 2px; text-transform: uppercase;">
      [ ACCESS_RECOVERY_MODE ]
    </span>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="color: #ffffff; font-size: 16px; font-weight: bold;">{{ text_greeting }}</p>
    <p style="font-size: 14px; line-height: 1.6; color: #888888;">> [SYSTEM]: {{ text_change }}</p>
  </div>

  <div style="text-align: center; margin: 40px 0; padding: 20px; background: #0a0a0a; border: 1px dashed #333;">
    <a href="{{ reset }}" style="background-color: #ff0000; color: #000000; padding: 15px 35px; text-decoration: none; font-family: Arial, sans-serif; font-weight: 900; font-size: 14px; letter-spacing: 2px; display: inline-block; text-transform: uppercase;">
      RECOVER_ACCESS_NOW
    </a>
    <p style="color: #444444; font-size: 10px; margin-top: 15px;">
      SECURE_LINK_GENERATED_BY_LAUNCH_PRO3
    </p>
  </div>

  <div style="background-color: #111111; padding: 15px; border-left: 3px solid #333333; margin-bottom: 30px;">
    <p style="color: #666666; font-size: 11px; margin: 0;">
      <span style="color: #ff0000;">[TRACE_INFO]:</span> {{ text_ip }} <br>
      <span style="color: #ffffff; font-size: 13px;">{{ ip }}</span>
    </p>
  </div>

  <div style="border-top: 1px solid #1a1a1a; padding-top: 20px;">
    <p style="font-size: 12px; color: #444444; margin: 0;">
      {{ store }}<br/>
      <a href="{{ store_url }}" style="color: #ff0000; text-decoration: none; font-size: 10px;">{{ store_url }}</a>
    </p>
  </div>

  <div style="margin-top: 30px; text-align: right; opacity: 0.1; font-size: 8px; color: #ffffff; letter-spacing: 4px;">
    LAUNCH_SECURITY_PROTOCOL_v4.2
  </div>
</div>